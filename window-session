#!/bin/bash

set -Eeuo pipefail
umask 077

ACTION=${1:-status}
HYPRCTL_BIN=${OMARCHY_KIDS_HYPRCTL:-hyprctl}
STATE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-kids
STATE_FILE=$STATE_DIR/windows.json
LOCK_FILE=$STATE_DIR/windows.lock
PARENT_WORKSPACE=special:omarchy-kids-parent
QUARANTINE_WORKSPACE=special:omarchy-kids-quarantine
KIDS_WORKSPACE=1
PROC_ROOT=${OMARCHY_KIDS_PROC_ROOT:-/proc}

mkdir -p -- "$STATE_DIR"
chmod 700 "$STATE_DIR"
exec 9>"$LOCK_FILE"
flock -w 5 -x 9

emit() {
  jq -cn \
    --arg action "$1" \
    --arg status "$2" \
    --argjson hidden "${3:-0}" \
    --argjson restored "${4:-0}" \
    --argjson blocked "${5:-0}" \
    --argjson expected "${6:-0}" \
    --argjson live "${7:-0}" \
    --argjson missing "${8:-0}" \
    --argjson failed "${9:-0}" \
    --argjson evacuated "${10:-0}" \
    --argjson kidsRemaining "${11:-0}" \
    --argjson workspaceRemoved "${12:-false}" \
    '{action: $action, status: $status, hidden: $hidden, restored: $restored,
      blocked: $blocked, expected: $expected, live: $live, missing: $missing,
      failed: $failed, evacuated: $evacuated, kidsRemaining: $kidsRemaining,
      workspaceRemoved: $workspaceRemoved}'
}

current_instance() {
  if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
    printf '%s\n' "$HYPRLAND_INSTANCE_SIGNATURE"
    return
  fi

  "$HYPRCTL_BIN" instances -j 2>/dev/null \
    | jq -r '.[0].instance // .[0].signature // empty'
}

workspace_selector() {
  local name=${1:-1}
  if [[ $name == special:* || $name =~ ^[0-9]+$ ]]; then
    printf '%s\n' "$name"
  else
    printf 'name:%s\n' "$name"
  fi
}

lua_string() {
  local value=$1
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  value=${value//$'\n'/\\n}
  value=${value//$'\r'/\\r}
  value=${value//$'\t'/\\t}
  printf '"%s"' "$value"
}

move_window() {
  local workspace=$1 address=$2 workspace_arg window_arg
  workspace_arg=$(lua_string "$workspace")
  window_arg=$(lua_string "address:$address")
  "$HYPRCTL_BIN" --quiet dispatch \
    "hl.dsp.window.move({ workspace = $workspace_arg, follow = false, window = $window_arg })"
}

close_window() {
  local window_arg
  window_arg=$(lua_string "address:$1")
  "$HYPRCTL_BIN" --quiet dispatch \
    "hl.dsp.window.close({ window = $window_arg })"
}

focus_workspace() {
  local workspace_arg
  workspace_arg=$(lua_string "$1")
  "$HYPRCTL_BIN" --quiet dispatch "hl.dsp.focus({ workspace = $workspace_arg })"
}

focus_monitor() {
  local monitor_arg
  monitor_arg=$(lua_string "$1")
  "$HYPRCTL_BIN" --quiet dispatch "hl.dsp.focus({ monitor = $monitor_arg })"
}

focus_window() {
  local window_arg
  window_arg=$(lua_string "address:$1")
  "$HYPRCTL_BIN" --quiet dispatch "hl.dsp.focus({ window = $window_arg })"
}

set_window_pin() {
  local action_arg window_arg
  action_arg=$(lua_string "$1")
  window_arg=$(lua_string "address:$2")
  "$HYPRCTL_BIN" --quiet dispatch \
    "hl.dsp.window.pin({ action = $action_arg, window = $window_arg })"
}

address_in_file() {
  local address=$1 clients_file=$2
  jq -e --arg address "$address" 'any(.[]; .address == $address)' \
    "$clients_file" >/dev/null
}

saved_window_in_file() {
  local saved_window=$1 clients_file=$2
  jq -e --argjson saved "$saved_window" '
    def saved_matches($saved; $client):
      $client.address == $saved.address
      and (($saved.pid // 0) == 0
        or ($client.pid // 0) == ($saved.pid // 0))
      and (($saved.initialClass // "") == ""
        or ($client.initialClass // $client.class // "") == $saved.initialClass)
      and (($saved.initialTitle // "") == ""
        or ($client.initialTitle // $client.title // "") == $saved.initialTitle);
    any(.[]; saved_matches($saved; .))
  ' "$clients_file" >/dev/null
}

post_entry_window_count() {
  local clients_file=$1
  jq \
    --arg parentWorkspace "$PARENT_WORKSPACE" \
    --slurpfile state "$STATE_FILE" \
    'def saved_matches($saved; $client):
      $client.address == $saved.address
      and (($saved.pid // 0) == 0
        or ($client.pid // 0) == ($saved.pid // 0))
      and (($saved.initialClass // "") == ""
        or ($client.initialClass // $client.class // "") == $saved.initialClass)
      and (($saved.initialTitle // "") == ""
        or ($client.initialTitle // $client.title // "") == $saved.initialTitle);
    [.[] as $client
      | $client
      | select((.mapped // true) == true)
      | select((.workspace.name // "") != $parentWorkspace)
      | select(any($state[0].windows[]; saved_matches(.; $client)) | not)]
    | length' "$clients_file"
}

session_for_instance() {
  local instance=$1
  [[ -f $STATE_FILE ]] \
    && jq -e --arg instance "$instance" \
      '.version == 1 and .active == true and .instance == $instance' \
      "$STATE_FILE" >/dev/null 2>&1
}

active_for_instance() {
  local instance=$1
  session_for_instance "$instance" \
    && jq -e '.status == "active"' "$STATE_FILE" >/dev/null 2>&1
}

record_state_status() {
  local status=$1 expected=$2 live=$3 missing=$4 failed=$5 restored=$6
  local evacuated=${7:-0} kids_remaining=${8:-0} workspace_removed=${9:-false} state_tmp
  state_tmp=$(mktemp "$STATE_DIR/windows.XXXXXX")
  jq \
    --arg status "$status" \
    --arg updatedAt "$(date --iso-8601=seconds)" \
    --argjson expected "$expected" \
    --argjson live "$live" \
    --argjson missing "$missing" \
    --argjson failed "$failed" \
    --argjson restored "$restored" \
    --argjson evacuated "$evacuated" \
    --argjson kidsRemaining "$kids_remaining" \
    --argjson workspaceRemoved "$workspace_removed" \
    '.status = $status | .updatedAt = $updatedAt | .expected = $expected
      | .live = $live | .missing = $missing | .failed = $failed
      | .restored = $restored | .evacuated = $evacuated
      | .kidsRemaining = $kidsRemaining | .workspaceRemoved = $workspaceRemoved' \
    "$STATE_FILE" > "$state_tmp"
  mv -- "$state_tmp" "$STATE_FILE"
}

enter_session() {
  local instance hidden=0 moved=0 failed=0
  instance=$(current_instance)
  [[ -n $instance ]] || { emit enter unavailable 0 0 0 0 0 0 1; return 1; }

  if session_for_instance "$instance"; then
    hidden=$(jq -r '.windows | length' "$STATE_FILE")
    if active_for_instance "$instance"; then
      emit enter already-active "$hidden" 0 0 "$hidden" "$hidden"
      return
    fi
    emit enter incomplete-session "$hidden" 0 0 "$hidden" "$hidden" 0 1
    return 1
  fi

  local clients_file active_window_file active_workspace_file state_tmp
  clients_file=$(mktemp "$STATE_DIR/clients.XXXXXX")
  active_window_file=$(mktemp "$STATE_DIR/active-window.XXXXXX")
  active_workspace_file=$(mktemp "$STATE_DIR/active-workspace.XXXXXX")
  state_tmp=$(mktemp "$STATE_DIR/windows.XXXXXX")
  trap 'rm -f -- "$clients_file" "$active_window_file" "$active_workspace_file" "$state_tmp"' RETURN

  if ! "$HYPRCTL_BIN" -j clients > "$clients_file" \
      || ! jq -e 'type == "array"' "$clients_file" >/dev/null; then
    emit enter unavailable 0 0 0 0 0 0 1
    return 1
  fi
  if ! "$HYPRCTL_BIN" -j activewindow > "$active_window_file" \
      || ! jq -e 'type == "object"' "$active_window_file" >/dev/null; then
    emit enter unavailable 0 0 0 0 0 0 1
    return 1
  fi
  if ! "$HYPRCTL_BIN" -j activeworkspace > "$active_workspace_file" \
      || ! jq -e 'type == "object"' "$active_workspace_file" >/dev/null; then
    emit enter unavailable 0 0 0 0 0 0 1
    return 1
  fi
  if ! jq -n \
      --arg instance "$instance" \
      --arg parentWorkspace "$PARENT_WORKSPACE" \
      --arg kidsWorkspace "$KIDS_WORKSPACE" \
      --arg capturedAt "$(date --iso-8601=seconds)" \
      --slurpfile clients "$clients_file" \
      --slurpfile activeWindow "$active_window_file" \
      --slurpfile activeWorkspace "$active_workspace_file" \
      '{
        version: 1,
        active: true,
        status: "entering",
        admissionVersion: 2,
        admittedProcesses: [],
        instance: $instance,
        parentWorkspace: $parentWorkspace,
        kidsWorkspace: $kidsWorkspace,
        capturedAt: $capturedAt,
        originalActiveWindow: ($activeWindow[0].address // ""),
        originalActiveWorkspace: ($activeWorkspace[0].name // "1"),
        originalActiveMonitor: ($activeWorkspace[0].monitor // ""),
        windows: [
          $clients[0][]
          | select((.mapped // true) == true)
          | select((.address // "") != "")
          | select((.workspace.name // "") != $parentWorkspace)
          | {
              address,
              pid: (.pid // 0),
              workspace: (.workspace.name // "1"),
              class: (.class // ""),
              title: (.title // ""),
              initialClass: (.initialClass // .class // ""),
              initialTitle: (.initialTitle // .title // ""),
              pinned: (.pinned // false),
              floating: (.floating // false),
              fullscreen: (.fullscreen // 0)
            }
        ]
      }' > "$state_tmp"; then
    emit enter unavailable 0 0 0 0 0 0 1
    return 1
  fi

  mv -- "$state_tmp" "$STATE_FILE"
  rm -f -- "$clients_file" "$active_window_file" "$active_workspace_file"
  trap - RETURN
  hidden=$(jq -r '.windows | length' "$STATE_FILE")

  while IFS=$'\t' read -r address pinned; do
    if [[ ! $address =~ ^0x[0-9a-fA-F]+$ ]]; then
      failed=$((failed + 1))
      continue
    fi
    if [[ $pinned == true ]] && ! set_window_pin off "$address"; then
      failed=$((failed + 1))
      continue
    fi
    if move_window "$PARENT_WORKSPACE" "$address"; then
      moved=$((moved + 1))
    else
      failed=$((failed + 1))
      if [[ $pinned == true ]]; then set_window_pin on "$address" || true; fi
    fi
  done < <(jq -r '.windows[] | [.address, (.pinned | tostring)] | @tsv' "$STATE_FILE")

  if ! focus_workspace "$KIDS_WORKSPACE"; then
    failed=$((failed + 1))
  fi

  if ((failed > 0 || moved != hidden)); then
    record_state_status enter-failed "$hidden" "$hidden" 0 "$failed" 0
    emit enter enter-failed "$moved" 0 0 "$hidden" "$hidden" 0 "$failed"
    return 1
  fi

  record_state_status active "$hidden" "$hidden" 0 0 0
  emit enter active "$moved" 0 0 "$hidden" "$hidden"
}

exit_session() {
  local instance expected=0 live=0 missing=0 restored=0 failed=0
  local evacuated=0 evacuation_expected=0 close_remaining=0 kids_remaining=0
  local post_entry_remaining=0
  local compensation_failed=0
  local original_monitor_available=false
  instance=$(current_instance)

  if [[ ! -f $STATE_FILE ]]; then
    emit exit inactive 0 0 0 0 0 0 0 0 0 true
    return
  fi

  if ! jq -e '.version == 1' "$STATE_FILE" >/dev/null 2>&1; then
    emit exit unavailable 0 0 0 0 0 0 1
    return 1
  fi

  if ! jq -e '.active == true' "$STATE_FILE" >/dev/null; then
    emit exit inactive 0 0 0 0 0 0 0 0 0 true
    return
  fi

  expected=$(jq -r '.windows | length' "$STATE_FILE")
  if [[ -z $instance ]]; then
    emit exit unavailable "$expected" 0 0 "$expected" 0 0 1
    return 1
  fi

  if [[ $(jq -r '.instance' "$STATE_FILE") != "$instance" ]]; then
    local stale_tmp
    stale_tmp=$(mktemp "$STATE_DIR/windows.XXXXXX")
    jq --arg endedAt "$(date --iso-8601=seconds)" \
      '.active = false | .status = "stale-session"
        | .kidsRemaining = 0 | .workspaceRemoved = true | .endedAt = $endedAt' \
      "$STATE_FILE" > "$stale_tmp"
    mv -- "$stale_tmp" "$STATE_FILE"
    emit exit stale-session 0 0 0 "$expected" 0 "$expected" 0 0 0 true
    return
  fi

  local clients_file moved_file close_targets_file state_tmp monitors_file
  local active_workspace_file post_clients_file
  clients_file=$(mktemp "$STATE_DIR/clients.XXXXXX")
  moved_file=$(mktemp "$STATE_DIR/moved.XXXXXX")
  close_targets_file=$(mktemp "$STATE_DIR/close-targets.XXXXXX")
  state_tmp=$(mktemp "$STATE_DIR/windows.XXXXXX")
  monitors_file=$(mktemp "$STATE_DIR/monitors.XXXXXX")
  active_workspace_file=$(mktemp "$STATE_DIR/active-workspace.XXXXXX")
  post_clients_file=$(mktemp "$STATE_DIR/post-clients.XXXXXX")
  trap 'rm -f -- "$clients_file" "$moved_file" "$close_targets_file" "$state_tmp" "$monitors_file" "$active_workspace_file" "$post_clients_file"' RETURN

  if ! "$HYPRCTL_BIN" -j clients > "$clients_file" \
      || ! jq -e 'type == "array"' "$clients_file" >/dev/null; then
    emit exit unavailable "$expected" 0 0 "$expected" 0 0 1
    return 1
  fi

  live=$(jq --slurpfile clients "$clients_file" '
    def saved_matches($saved; $client):
      $client.address == $saved.address
      and (($saved.pid // 0) == 0
        or ($client.pid // 0) == ($saved.pid // 0))
      and (($saved.initialClass // "") == ""
        or ($client.initialClass // $client.class // "") == $saved.initialClass)
      and (($saved.initialTitle // "") == ""
        or ($client.initialTitle // $client.title // "") == $saved.initialTitle);
    [.windows[] as $saved | $clients[0][] | select(saved_matches($saved; .))]
    | length' "$STATE_FILE")
  missing=$((expected - live))

  local row saved_window address workspace pinned selector
  local original_workspace original_window original_window_saved original_monitor
  original_workspace=$(jq -r '.originalActiveWorkspace // "1"' "$STATE_FILE")
  original_window=$(jq -r '.originalActiveWindow // ""' "$STATE_FILE")
  original_window_saved=$(jq -c --arg address "$original_window" \
    '.windows[] | select(.address == $address)' "$STATE_FILE" | head -1)
  original_monitor=$(jq -r '.originalActiveMonitor // ""' "$STATE_FILE")
  selector=$(workspace_selector "$original_workspace")

  evacuation_expected=$(jq \
    --arg parentWorkspace "$PARENT_WORKSPACE" \
    --slurpfile state "$STATE_FILE" \
    'def saved_matches($saved; $client):
      $client.address == $saved.address
      and (($saved.pid // 0) == 0
        or ($client.pid // 0) == ($saved.pid // 0))
      and (($saved.initialClass // "") == ""
        or ($client.initialClass // $client.class // "") == $saved.initialClass)
      and (($saved.initialTitle // "") == ""
        or ($client.initialTitle // $client.title // "") == $saved.initialTitle);
    [.[] as $client
      | $client
      | select((.mapped // true) == true)
      | select((.workspace.name // "") != $parentWorkspace)
      | select(any($state[0].windows[]; saved_matches(.; $client)) | not)]
    | length' "$clients_file")

  while IFS= read -r row; do
    address=$(base64 -d <<< "$row" | jq -r '.address // ""')
    printf '%s\n' "$address" >> "$close_targets_file"
    if [[ ! $address =~ ^0x[0-9a-fA-F]+$ ]]; then
      failed=$((failed + 1))
      continue
    fi
    # A normal close lets the client save or present a confirmation dialog. Its
    # disappearance below, rather than the dispatcher status, is authoritative.
    close_window "$address" || true
  done < <(jq -r \
    --arg parentWorkspace "$PARENT_WORKSPACE" \
    --slurpfile state "$STATE_FILE" \
    'def saved_matches($saved; $client):
      $client.address == $saved.address
      and (($saved.pid // 0) == 0
        or ($client.pid // 0) == ($saved.pid // 0))
      and (($saved.initialClass // "") == ""
        or ($client.initialClass // $client.class // "") == $saved.initialClass)
      and (($saved.initialTitle // "") == ""
        or ($client.initialTitle // $client.title // "") == $saved.initialTitle);
    .[] as $client
      | $client
      | select((.mapped // true) == true)
      | select((.workspace.name // "") != $parentWorkspace)
      | select(any($state[0].windows[]; saved_matches(.; $client)) | not)
      | @base64' "$clients_file")

  close_remaining=$evacuation_expected
  if ((failed == 0 && evacuation_expected > 0)); then
    local close_check_attempt close_check_complete=false
    local close_check_attempts=${OMARCHY_KIDS_CLOSE_ATTEMPTS:-20}
    local close_check_interval=${OMARCHY_KIDS_CLOSE_INTERVAL:-0.1}
    for ((close_check_attempt = 1; close_check_attempt <= close_check_attempts; close_check_attempt++)); do
      if ! "$HYPRCTL_BIN" -j clients > "$post_clients_file" \
          || ! jq -e 'type == "array"' "$post_clients_file" >/dev/null; then
        failed=$((failed + 1))
        break
      fi

      close_remaining=0
      while IFS= read -r address; do
        [[ -n $address ]] || continue
        if address_in_file "$address" "$post_clients_file"; then
          close_remaining=$((close_remaining + 1))
        fi
      done < "$close_targets_file"
      evacuated=$((evacuation_expected - close_remaining))
      post_entry_remaining=$(jq \
        --arg parentWorkspace "$PARENT_WORKSPACE" \
        --slurpfile state "$STATE_FILE" \
        'def saved_matches($saved; $client):
          $client.address == $saved.address
          and (($saved.pid // 0) == 0
            or ($client.pid // 0) == ($saved.pid // 0))
          and (($saved.initialClass // "") == ""
            or ($client.initialClass // $client.class // "") == $saved.initialClass)
          and (($saved.initialTitle // "") == ""
            or ($client.initialTitle // $client.title // "") == $saved.initialTitle);
        [.[] as $client
          | $client
          | select((.mapped // true) == true)
          | select((.workspace.name // "") != $parentWorkspace)
          | select(any($state[0].windows[]; saved_matches(.; $client)) | not)]
        | length' "$post_clients_file")
      if ((close_remaining == 0 && post_entry_remaining == 0)); then
        close_check_complete=true
        break
      fi
      sleep "$close_check_interval"
    done
    if [[ $close_check_complete != true ]]; then
      failed=$((failed + 1))
    fi
  fi

  # Do not reveal the original desktop's windows while a Kids Mode client is still
  # handling (or refusing) its graceful close request.
  if ((failed == 0)); then
    while IFS= read -r row; do
      saved_window=$(base64 -d <<< "$row")
      address=$(jq -r '.address' <<< "$saved_window")
      workspace=$(jq -r '.workspace // "1"' <<< "$saved_window")
      pinned=$(jq -r '.pinned // false' <<< "$saved_window")
      if [[ ! $address =~ ^0x[0-9a-fA-F]+$ ]]; then
        failed=$((failed + 1))
        continue
      fi
      saved_window_in_file "$saved_window" "$clients_file" || continue

      if ! move_window "$(workspace_selector "$workspace")" "$address"; then
        failed=$((failed + 1))
        continue
      fi
      printf '%s\t%s\n' "$address" "$pinned" >> "$moved_file"

      if [[ $pinned == true ]] && ! set_window_pin on "$address"; then
        failed=$((failed + 1))
        continue
      fi
      restored=$((restored + 1))
    done < <(jq -r '.windows[] | @base64' "$STATE_FILE")
  fi

  if ((failed == 0)) && [[ -n $original_monitor ]]; then
    if ! "$HYPRCTL_BIN" -j monitors > "$monitors_file" \
        || ! jq -e 'type == "array"' "$monitors_file" >/dev/null; then
      failed=$((failed + 1))
    elif jq -e --arg monitor "$original_monitor" \
        'any(.[]; .name == $monitor)' "$monitors_file" >/dev/null; then
      original_monitor_available=true
      if ! focus_monitor "$original_monitor"; then
        failed=$((failed + 1))
      fi
    fi
  fi

  if ((failed == 0)) && ! focus_workspace "$selector"; then
    failed=$((failed + 1))
  fi
  if ((failed == 0)) && [[ $original_window =~ ^0x[0-9a-fA-F]+$ ]] \
      && [[ -n $original_window_saved ]] \
      && saved_window_in_file "$original_window_saved" "$clients_file" \
      && ! focus_window "$original_window"; then
    failed=$((failed + 1))
  fi

  if ((failed == 0)); then
    if ! "$HYPRCTL_BIN" -j activeworkspace > "$active_workspace_file" \
        || ! jq -e 'type == "object"' "$active_workspace_file" >/dev/null \
        || ! jq -e --arg workspace "$original_workspace" \
          '.name == $workspace' "$active_workspace_file" >/dev/null; then
      failed=$((failed + 1))
    elif [[ $original_monitor_available == true ]] \
        && ! jq -e --arg monitor "$original_monitor" \
          '.monitor == $monitor' "$active_workspace_file" >/dev/null; then
      failed=$((failed + 1))
    fi
  fi

  if ((failed == 0)); then
    if ! "$HYPRCTL_BIN" -j clients > "$post_clients_file" \
        || ! jq -e 'type == "array"' "$post_clients_file" >/dev/null; then
      failed=$((failed + 1))
    else
      kids_remaining=$(post_entry_window_count "$post_clients_file")
      if ((kids_remaining > 0)); then
        failed=$((failed + 1))
      fi
    fi
  else
    if jq -e 'type == "array"' "$post_clients_file" >/dev/null 2>&1; then
      kids_remaining=$(post_entry_window_count "$post_clients_file")
    else
      kids_remaining=$close_remaining
    fi
  fi

  if ((failed == 0)); then
    while IFS= read -r row; do
      saved_window=$(base64 -d <<< "$row")
      address=$(jq -r '.address' <<< "$saved_window")
      workspace=$(jq -r '.workspace // "1"' <<< "$saved_window")
      pinned=$(jq -r '.pinned // false' <<< "$saved_window")
      saved_window_in_file "$saved_window" "$post_clients_file" || continue
      if ! jq -e --arg address "$address" --arg workspace "$workspace" \
          --argjson pinned "$pinned" \
          'any(.[]; .address == $address
            and (.workspace.name // "") == $workspace
            and (.pinned // false) == $pinned)' \
          "$post_clients_file" >/dev/null; then
        failed=$((failed + 1))
      fi
    done < <(jq -r '.windows[] | @base64' "$STATE_FILE")

    while IFS= read -r address; do
      [[ -n $address ]] || continue
      if address_in_file "$address" "$post_clients_file"; then
        failed=$((failed + 1))
      fi
    done < "$close_targets_file"
  fi

  if ((failed > 0 || restored != live || evacuated != evacuation_expected)); then
    while IFS=$'\t' read -r address pinned; do
      [[ -n $address ]] || continue
      if [[ $pinned == true ]] && ! set_window_pin off "$address"; then
        compensation_failed=$((compensation_failed + 1))
      fi
      if ! move_window "$PARENT_WORKSPACE" "$address"; then
        compensation_failed=$((compensation_failed + 1))
      fi
    done < "$moved_file"
    if ! focus_workspace "$KIDS_WORKSPACE"; then
      compensation_failed=$((compensation_failed + 1))
    fi

    failed=$((failed + compensation_failed))
    record_state_status restore-failed "$expected" "$live" "$missing" "$failed" 0 \
      "$evacuated" "$kids_remaining" false
    emit exit restore-failed "$live" 0 0 "$expected" "$live" "$missing" "$failed" \
      "$evacuated" "$kids_remaining" false
    return 1
  fi

  jq \
    --arg endedAt "$(date --iso-8601=seconds)" \
    --argjson expected "$expected" \
    --argjson live "$live" \
    --argjson missing "$missing" \
    --argjson restored "$restored" \
    --argjson evacuated "$evacuated" \
    '.active = false | .status = "restored" | .expected = $expected
      | .live = $live | .missing = $missing | .failed = 0
      | .restored = $restored | .evacuated = $evacuated
      | .kidsRemaining = 0 | .workspaceRemoved = true | .endedAt = $endedAt' \
    "$STATE_FILE" > "$state_tmp"
  mv -- "$state_tmp" "$STATE_FILE"
  rm -f -- "$clients_file" "$moved_file" "$close_targets_file" "$monitors_file" \
    "$active_workspace_file" "$post_clients_file"
  trap - RETURN
  emit exit restored 0 "$restored" 0 "$expected" "$live" "$missing" 0 \
    "$evacuated" 0 true
}

guard_session() {
  local instance hidden=0 blocked=0 failed=0 moved=0
  local policy_json=${1:-}
  instance=$(current_instance)
  if [[ -z $instance ]] || ! session_for_instance "$instance"; then
    emit guard inactive
    return
  fi

  hidden=$(jq -r '.windows | length' "$STATE_FILE")
  if ! jq -e 'type == "object"
      and (.expectedWindows | type) == "array" and (.expectedWindows | length) <= 512
      and (.bootstrapClasses | type) == "array" and (.bootstrapClasses | length) <= 512
      and all(.expectedWindows[];
        type == "object"
        and (.address | type) == "string" and (.address | test("^0x[0-9a-fA-F]+$"))
        and (.classes | type) == "array" and (.classes | length) > 0 and (.classes | length) <= 32
        and all(.classes[]; type == "string" and length > 0 and length <= 256))
      and all(.bootstrapClasses[]; type == "string" and length > 0 and length <= 256)' \
      <<<"$policy_json" >/dev/null 2>&1; then
    emit guard unavailable "$hidden" 0 0 "$hidden" 0 0 1
    return 1
  fi

  local clients_file expected_file bootstrap_file admitted_file new_admitted_file
  local active_workspace_file moved_targets_file post_clients_file state_tmp
  clients_file=$(mktemp "$STATE_DIR/guard-clients.XXXXXX")
  expected_file=$(mktemp "$STATE_DIR/guard-expected.XXXXXX")
  bootstrap_file=$(mktemp "$STATE_DIR/guard-bootstrap.XXXXXX")
  admitted_file=$(mktemp "$STATE_DIR/guard-admitted.XXXXXX")
  new_admitted_file=$(mktemp "$STATE_DIR/guard-new-admitted.XXXXXX")
  active_workspace_file=$(mktemp "$STATE_DIR/guard-workspace.XXXXXX")
  moved_targets_file=$(mktemp "$STATE_DIR/guard-targets.XXXXXX")
  post_clients_file=$(mktemp "$STATE_DIR/guard-post-clients.XXXXXX")
  state_tmp=$(mktemp "$STATE_DIR/windows.XXXXXX")
  trap 'rm -f -- "$clients_file" "$expected_file" "$bootstrap_file" "$admitted_file" "$new_admitted_file" "$active_workspace_file" "$moved_targets_file" "$post_clients_file" "$state_tmp"' RETURN

  local bootstrapping=false
  if jq -e '.admissionVersion == null and .admittedProcesses == null' \
      "$STATE_FILE" >/dev/null 2>&1; then
    bootstrapping=true
  elif ! jq -e '.admissionVersion == 2 and (.admittedProcesses | type) == "array"
      and (.admittedProcesses | length) <= 512
      and all(.admittedProcesses[];
        type == "object" and (.pid | type) == "number" and (.pid | floor) == .pid
        and .pid > 0 and (.startTime | type) == "string"
        and (.startTime | test("^[0-9]+$")))' \
      "$STATE_FILE" >/dev/null 2>&1; then
    emit guard unavailable "$hidden" 0 0 "$hidden" 0 0 1
    return 1
  fi

  if ! jq -c '.expectedWindows
          | map({address: (.address | ascii_downcase), classes: (.classes | map(ascii_downcase) | unique)})' \
        <<<"$policy_json" >"$expected_file" \
      || ! jq -c '.bootstrapClasses | map(ascii_downcase) | unique' \
        <<<"$policy_json" >"$bootstrap_file" \
      || ! jq -c 'if .admissionVersion == 2 and (.admittedProcesses | type) == "array"
          then .admittedProcesses else [] end | unique_by(.pid, .startTime)' \
        "$STATE_FILE" >"$admitted_file" \
      || ! "$HYPRCTL_BIN" -j clients >"$clients_file" 2>/dev/null \
      || ! jq -e 'type == "array"' "$clients_file" >/dev/null; then
    emit guard unavailable "$hidden" 0 0 "$hidden" 0 0 1
    return 1
  fi

  local visible_workspace=$KIDS_WORKSPACE
  if "$HYPRCTL_BIN" -j activeworkspace >"$active_workspace_file" 2>/dev/null \
      && jq -e 'type == "object"' "$active_workspace_file" >/dev/null; then
    local active_workspace
    active_workspace=$(jq -r '.name // ""' "$active_workspace_file")
    if [[ -n $active_workspace && $active_workspace != special:* ]]; then
      visible_workspace=$(workspace_selector "$active_workspace")
    fi
  fi

  parent_owned_pid() {
    local pid=${1:-0} parent depth=0
    [[ $pid =~ ^[1-9][0-9]*$ ]] || return 1
    while ((pid > 1 && depth < 64)); do
      if jq -e --argjson pid "$pid" \
          'any(.windows[]; (.pid // 0) == $pid)' "$STATE_FILE" >/dev/null; then
        return 0
      fi
      [[ -r $PROC_ROOT/$pid/status ]] || return 1
      parent=$(awk '$1 == "PPid:" { print $2; exit }' "$PROC_ROOT/$pid/status")
      [[ $parent =~ ^[0-9]+$ && $parent -ne $pid ]] || return 1
      pid=$parent
      depth=$((depth + 1))
    done
    return 1
  }

  process_start_time() {
    local pid=${1:-0} stat_line fields
    [[ $pid =~ ^[1-9][0-9]*$ && -r $PROC_ROOT/$pid/stat ]] || return 1
    IFS= read -r stat_line <"$PROC_ROOT/$pid/stat" || return 1
    fields=${stat_line##*) }
    awk '{print $20}' <<<"$fields" | grep -Eq '^[0-9]+$' || return 1
    awk '{print $20}' <<<"$fields"
  }

  admitted_owned_pid() {
    local pid=${1:-0} parent start_time depth=0
    [[ $pid =~ ^[1-9][0-9]*$ ]] || return 1
    while ((pid > 1 && depth < 64)); do
      start_time=$(process_start_time "$pid") || return 1
      if jq -e --argjson pid "$pid" --arg startTime "$start_time" \
          'any(.[]; .pid == $pid and .startTime == $startTime)' \
          "$admitted_file" >/dev/null; then
        return 0
      fi
      [[ -r $PROC_ROOT/$pid/status ]] || return 1
      parent=$(awk '$1 == "PPid:" { print $2; exit }' "$PROC_ROOT/$pid/status")
      [[ $parent =~ ^[0-9]+$ && $parent -ne $pid ]] || return 1
      pid=$parent
      depth=$((depth + 1))
    done
    return 1
  }

  local row client address workspace pid pinned window_class initial_class target
  local saved_match class_selected class_expected process_admitted newly_admitted
  while IFS= read -r row; do
    client=$(base64 -d <<<"$row")
    address=$(jq -r '.address // ""' <<<"$client")
    workspace=$(jq -r '.workspace.name // ""' <<<"$client")
    pid=$(jq -r '.pid // 0' <<<"$client")
    pinned=$(jq -r '.pinned // false' <<<"$client")
    window_class=$(jq -r '.class // "" | ascii_downcase' <<<"$client")
    initial_class=$(jq -r '.initialClass // "" | ascii_downcase' <<<"$client")
    if [[ ! $address =~ ^0x[0-9a-fA-F]+$ ]]; then
      failed=$((failed + 1))
      continue
    fi

    saved_match=false
    if jq -e --argjson client "$client" '
        def saved_matches($saved; $current):
          $current.address == $saved.address
          and (($saved.pid // 0) == 0
            or ($current.pid // 0) == ($saved.pid // 0))
          and (($saved.initialClass // "") == ""
            or ($current.initialClass // $current.class // "") == $saved.initialClass)
          and (($saved.initialTitle // "") == ""
            or ($current.initialTitle // $current.title // "") == $saved.initialTitle);
        any(.windows[]; saved_matches(.; $client))
      ' "$STATE_FILE" >/dev/null; then
      saved_match=true
    fi

    class_selected=false
    if jq -e --arg class "$window_class" --arg initialClass "$initial_class" \
        'index($class) != null or index($initialClass) != null' \
        "$bootstrap_file" >/dev/null; then
      class_selected=true
    fi
    class_expected=false
    if jq -e --arg address "${address,,}" --arg class "$window_class" \
        --arg initialClass "$initial_class" \
        'any(.[]; .address == $address
          and ((.classes | index($class)) != null
            or (.classes | index($initialClass)) != null))' \
        "$expected_file" >/dev/null; then
      class_expected=true
    fi
    process_admitted=false
    if admitted_owned_pid "$pid"; then process_admitted=true; fi

    target=""
    if [[ $saved_match == true ]] || parent_owned_pid "$pid"; then
      if [[ $workspace != "$PARENT_WORKSPACE" ]]; then
        target=$PARENT_WORKSPACE
        blocked=$((blocked + 1))
      fi
    elif [[ $class_selected == true \
        && ($process_admitted == true || $class_expected == true || $bootstrapping == true) ]]; then
      if [[ $process_admitted != true && $pid =~ ^[1-9][0-9]*$ ]]; then
        if start_time=$(process_start_time "$pid"); then
          jq -cn --argjson pid "$pid" --arg startTime "$start_time" \
            '{pid: $pid, startTime: $startTime}' >>"$new_admitted_file"
        else
          failed=$((failed + 1))
          continue
        fi
      fi
      if [[ $workspace == "$QUARANTINE_WORKSPACE" ]]; then target=$visible_workspace; fi
    else
      if [[ $workspace != "$QUARANTINE_WORKSPACE" ]]; then
        target=$QUARANTINE_WORKSPACE
        blocked=$((blocked + 1))
      fi
    fi

    [[ -n $target ]] || continue
    if [[ $pinned == true ]] && ! set_window_pin off "$address"; then
      failed=$((failed + 1))
      continue
    fi

    if move_window "$target" "$address"; then
      moved=$((moved + 1))
      printf '%s\t%s\n' "$address" "$target" >>"$moved_targets_file"
    else
      failed=$((failed + 1))
    fi
  done < <(jq -r '.[] | select((.mapped // true) == true) | @base64' "$clients_file")

  if ((moved > 0)) && ! focus_workspace "$visible_workspace"; then
    failed=$((failed + 1))
  fi
  if ((moved > 0)); then
    if ! "$HYPRCTL_BIN" -j clients >"$post_clients_file" 2>/dev/null \
        || ! jq -e 'type == "array"' "$post_clients_file" >/dev/null; then
      failed=$((failed + 1))
    else
      while IFS=$'\t' read -r address target; do
        if ! jq -e --arg address "$address" --arg workspace "$target" \
            'any(.[]; .address == $address
              and (.workspace.name // "") == $workspace
              and (.pinned // false) == false)' \
            "$post_clients_file" >/dev/null; then
          failed=$((failed + 1))
        fi
      done <"$moved_targets_file"
    fi
  fi
  if ((failed > 0)); then
    emit guard admission-failed "$hidden" 0 "$blocked" "$hidden" "$hidden" 0 "$failed"
    return 1
  fi
  newly_admitted=$(jq -sc '.[0] + .[1:] | unique_by(.pid, .startTime)' \
    "$admitted_file" "$new_admitted_file")
  if ! jq -e 'length <= 512' <<<"$newly_admitted" >/dev/null \
      || ! jq --argjson admittedProcesses "$newly_admitted" \
        '.admissionVersion = 2 | .admittedProcesses = $admittedProcesses' \
        "$STATE_FILE" >"$state_tmp"; then
    emit guard admission-failed "$hidden" 0 "$blocked" "$hidden" "$hidden" 0 1
    return 1
  fi
  mv -- "$state_tmp" "$STATE_FILE"
  emit guard active "$hidden" 0 "$blocked" "$hidden" "$hidden"
}

status_session() {
  local instance hidden=0 status
  instance=$(current_instance || true)
  if [[ ! -e $STATE_FILE ]]; then
    emit status inactive
  elif ! jq -e '.version == 1 and (.active | type) == "boolean"
      and (.windows | type) == "array" and (.instance | type) == "string"' \
      "$STATE_FILE" >/dev/null 2>&1; then
    emit status unavailable 0 0 0 0 0 0 1
    return 1
  elif jq -e '.active == false
      and (.status == "restored" or .status == "stale-session")
      and (.kidsRemaining // 0) == 0 and (.workspaceRemoved // false) == true' \
      "$STATE_FILE" >/dev/null; then
    emit status inactive
  elif jq -e '.active == false' "$STATE_FILE" >/dev/null; then
    emit status unavailable 0 0 0 0 0 0 1
    return 1
  elif [[ -z $instance ]]; then
    emit status unavailable 0 0 0 0 0 0 1
    return 1
  elif session_for_instance "$instance"; then
    hidden=$(jq -r '.windows | length' "$STATE_FILE")
    status=$(jq -r '.status // "unknown"' "$STATE_FILE")
    emit status "$status" "$hidden" 0 0 "$hidden" "$hidden"
  else
    hidden=$(jq -r '.windows | length' "$STATE_FILE")
    emit status stale-session "$hidden" 0 0 "$hidden" "$hidden"
  fi
}

case "$ACTION" in
  enter) enter_session ;;
  exit) exit_session ;;
  guard) guard_session "${2:-}" ;;
  status) status_session ;;
  *)
    printf 'usage: %s {enter|exit|guard|status}\n' "$0" >&2
    exit 2
    ;;
esac
