#!/bin/bash

set -Eeuo pipefail

PLUGIN_ID=io.github.elgevan.omarchy-kids
HYPRCTL_BIN=${OMARCHY_KIDS_HYPRCTL:-hyprctl}
RUNTIME_ROOT=${XDG_RUNTIME_DIR:-/tmp/omarchy-kids-runtime-$UID}
STATE_DIR=$RUNTIME_ROOT/omarchy-kids
ACTIVE_MARKER=$STATE_DIR/shortcut-policy.active
LOCK_FILE=$STATE_DIR/shortcut-policy.lock

usage() {
  echo "Usage: shortcut-policy enter <browser-allowed> <omawrite-allowed> <omacalc-allowed> | exit | status" >&2
  exit 2
}

json_result() {
  local action=$1 applied=$2 changed=$3 restored=$4 error=${5:-}
  jq -nc \
    --arg action "$action" \
    --argjson applied "$applied" \
    --argjson changed "$changed" \
    --argjson restored "$restored" \
    --arg error "$error" \
    '{version: 1, action: $action, applied: $applied, changed: $changed,
      skippedCustom: 0, restored: $restored}
      + (if $error == "" then {} else {error: $error} end)'
}

reload_bindings() {
  local output
  if ! output=$($HYPRCTL_BIN reload 2>&1); then
    printf '%s' "$output"
    return 1
  fi
  if ! output=$($HYPRCTL_BIN eval \
      'hl.dispatch(hl.dsp.submap("reset")); assert(hl.get_current_submap() == "", "Hyprland submap did not reset")' \
      2>&1); then
    printf '%s' "$output"
    return 1
  fi
}

is_boolean() {
  [[ $1 == true || $1 == false ]]
}

mkdir -p -- "$STATE_DIR"
chmod 700 "$STATE_DIR"
exec 9>"$LOCK_FILE"
flock 9

action=${1:-}
case $action in
  status)
    if [[ -f $ACTIVE_MARKER ]]; then
      json_result status true 0 false
    else
      json_result status false 0 false
    fi
    exit 0
    ;;
  exit)
    if [[ ! -f $ACTIVE_MARKER ]]; then
      json_result exit false 0 false
      exit 0
    fi

    if error=$(reload_bindings); then
      rm -f -- "$ACTIVE_MARKER"
      json_result exit false 0 true
      exit 0
    fi

    json_result exit true 0 false "Could not restore Hyprland bindings: $error"
    exit 1
    ;;
  enter)
    ;;
  *)
    usage
    ;;
esac

browser_allowed=${2:-}
omawrite_allowed=${3:-}
omacalc_allowed=${4:-}
is_boolean "$browser_allowed" || usage
is_boolean "$omawrite_allowed" || usage
is_boolean "$omacalc_allowed" || usage

# A shell/plugin reload can construct this service again without first disabling
# it. Start from the user's real configuration before rebuilding the transient
# submap so a previous instance never accumulates bindings.
if [[ -f $ACTIVE_MARKER ]]; then
  if ! error=$(reload_bindings); then
    json_result enter false 0 false "Could not reset the previous shortcut layer: $error"
    exit 1
  fi
  rm -f -- "$ACTIVE_MARKER"
fi

if ! bindings_json=$($HYPRCTL_BIN binds -j 2>&1); then
  json_result enter false 0 false "Could not inspect Hyprland bindings: $bindings_json"
  exit 1
fi

if ! jq -e 'type == "array"' <<<"$bindings_json" >/dev/null 2>&1; then
  json_result enter false 0 false "Hyprland returned invalid binding data"
  exit 1
fi

# A submap disables every ordinary global binding, including user-created ones.
# Hyprland's universal bindings deliberately bypass submaps, so refuse to claim
# that the policy is active if the current configuration contains any.
if jq -e 'any(.[]; (.submap_universal // false) == true)' \
    <<<"$bindings_json" >/dev/null; then
  json_result enter false 0 false \
    "A universal Hyprland binding can bypass the Kids Mode shortcut policy"
  exit 1
fi

if jq -e 'any(.[]; (.submap // "") == "omarchy-kids")' \
    <<<"$bindings_json" >/dev/null; then
  json_result enter false 0 false \
    "The omarchy-kids Hyprland submap name is already in use"
  exit 1
fi

lua_program='hl.define_submap("omarchy-kids", function()'
changed=0

append_lua() {
  printf -v lua_program '%s\n%s' "$lua_program" "$1"
  changed=$((changed + 1))
}

# Plugin-owned entry points.
append_lua "  hl.bind(\"SUPER + SPACE\", hl.dsp.exec_cmd([[omarchy-shell shell toggle $PLUGIN_ID '{\"menu\":\"root\"}']]), { description = \"Kids Mode: Menu\" })"
append_lua "  hl.bind(\"SUPER + ALT + SPACE\", hl.dsp.exec_cmd([[omarchy-shell shell toggle $PLUGIN_ID '{\"menu\":\"apps\"}']]), { description = \"Kids Mode: Apps\" })"
append_lua "  hl.bind(\"SUPER + CTRL + SPACE\", hl.dsp.exec_cmd([[omarchy-shell shell toggle $PLUGIN_ID '{\"menu\":\"style.background\"}']]), { description = \"Kids Mode: Background\" })"
append_lua "  hl.bind(\"SUPER + SHIFT + CTRL + SPACE\", hl.dsp.exec_cmd([[omarchy-shell shell toggle $PLUGIN_ID '{\"menu\":\"style.theme\"}']]), { description = \"Kids Mode: Theme\" })"

if [[ $browser_allowed == true ]]; then
  append_lua "  hl.bind(\"SUPER + SHIFT + RETURN\", hl.dsp.exec_cmd([[omarchy-shell shell call $PLUGIN_ID launchKidsBrowser '{}']]), { description = \"Kids Mode: Browser\" })"
  append_lua "  hl.bind(\"SUPER + SHIFT + B\", hl.dsp.exec_cmd([[omarchy-shell shell call $PLUGIN_ID launchKidsBrowser '{}']]), { description = \"Kids Mode: Browser\" })"
fi
if [[ $omawrite_allowed == true ]]; then
  append_lua "  hl.bind(\"SUPER + SHIFT + W\", hl.dsp.exec_cmd([[omarchy-shell shell call $PLUGIN_ID launchAllowedApp '{\"desktopId\":\"omawrite\",\"name\":\"Omawrite\"}']]), { description = \"Kids Mode: Omawrite\" })"
fi
if [[ $omacalc_allowed == true ]]; then
  append_lua "  hl.bind(\"SUPER + CTRL + Q\", hl.dsp.exec_cmd([[omarchy-shell shell call $PLUGIN_ID launchAllowedApp '{\"desktopId\":\"omacalc\",\"name\":\"Omacalc\"}']]), { description = \"Kids Mode: Calculator\" })"
  append_lua "  hl.bind(\"XF86Calculator\", hl.dsp.exec_cmd([[omarchy-shell shell call $PLUGIN_ID launchAllowedApp '{\"desktopId\":\"omacalc\",\"name\":\"Omacalc\"}']]), { description = \"Kids Mode: Calculator\" })"
fi

# Everyday window controls that do not expose other workspaces or applications.
append_lua '  hl.bind("SUPER + W", hl.dsp.window.close(), { description = "Close window" })'
append_lua '  hl.bind("SUPER + T", hl.dsp.window.float({ action = "toggle" }), { description = "Toggle window floating/tiling" })'
append_lua '  hl.bind("SUPER + F", hl.dsp.window.fullscreen({ mode = "fullscreen" }), { description = "Full screen" })'
append_lua '  hl.bind("SUPER + LEFT", hl.dsp.focus({ direction = "l" }), { description = "Focus on left window" })'
append_lua '  hl.bind("SUPER + RIGHT", hl.dsp.focus({ direction = "r" }), { description = "Focus on right window" })'
append_lua '  hl.bind("SUPER + UP", hl.dsp.focus({ direction = "u" }), { description = "Focus on above window" })'
append_lua '  hl.bind("SUPER + DOWN", hl.dsp.focus({ direction = "d" }), { description = "Focus on below window" })'
append_lua '  hl.bind("SUPER + SHIFT + LEFT", hl.dsp.window.swap({ direction = "l" }), { description = "Swap window to the left" })'
append_lua '  hl.bind("SUPER + SHIFT + RIGHT", hl.dsp.window.swap({ direction = "r" }), { description = "Swap window to the right" })'
append_lua '  hl.bind("SUPER + SHIFT + UP", hl.dsp.window.swap({ direction = "u" }), { description = "Swap window up" })'
append_lua '  hl.bind("SUPER + SHIFT + DOWN", hl.dsp.window.swap({ direction = "d" }), { description = "Swap window down" })'
append_lua '  hl.bind("ALT + TAB", hl.dsp.window.cycle_next(), { description = "Focus on next window" })'
append_lua '  hl.bind("ALT + SHIFT + TAB", hl.dsp.window.cycle_next({ next = false }), { description = "Focus on previous window" })'

# Hardware controls remain available while the default/global submap is masked.
append_lua '  hl.bind("XF86AudioRaiseVolume", hl.dsp.exec_cmd("omarchy-audio-output-volume raise"), { description = "Volume up", locked = true, repeating = true })'
append_lua '  hl.bind("XF86AudioLowerVolume", hl.dsp.exec_cmd("omarchy-audio-output-volume lower"), { description = "Volume down", locked = true, repeating = true })'
append_lua '  hl.bind("XF86AudioMute", hl.dsp.exec_cmd("omarchy-audio-output-volume mute-toggle"), { description = "Mute", locked = true })'
append_lua '  hl.bind("XF86AudioMicMute", hl.dsp.exec_cmd("omarchy-audio-input-mute"), { description = "Mute microphone", locked = true })'
append_lua '  hl.bind("XF86MonBrightnessUp", hl.dsp.exec_cmd("omarchy-brightness-display +5%"), { description = "Brightness up", locked = true, repeating = true })'
append_lua '  hl.bind("XF86MonBrightnessDown", hl.dsp.exec_cmd("omarchy-brightness-display 5%-"), { description = "Brightness down", locked = true, repeating = true })'
append_lua '  hl.bind("XF86KbdBrightnessUp", hl.dsp.exec_cmd("omarchy-brightness-keyboard up"), { description = "Keyboard brightness up", locked = true, repeating = true })'
append_lua '  hl.bind("XF86KbdBrightnessDown", hl.dsp.exec_cmd("omarchy-brightness-keyboard down"), { description = "Keyboard brightness down", locked = true, repeating = true })'
append_lua '  hl.bind("XF86KbdLightOnOff", hl.dsp.exec_cmd("omarchy-brightness-keyboard cycle"), { description = "Keyboard backlight cycle", locked = true })'
append_lua '  hl.bind("XF86AudioNext", hl.dsp.exec_cmd("omarchy-shell media next"), { description = "Next track", locked = true })'
append_lua '  hl.bind("XF86AudioPause", hl.dsp.exec_cmd("omarchy-shell media playPause"), { description = "Pause", locked = true })'
append_lua '  hl.bind("XF86AudioPlay", hl.dsp.exec_cmd("omarchy-shell media playPause"), { description = "Play", locked = true })'
append_lua '  hl.bind("XF86AudioPrev", hl.dsp.exec_cmd("omarchy-shell media previous"), { description = "Previous track", locked = true })'
append_lua '  hl.bind("SUPER + CTRL + L", hl.dsp.exec_cmd("omarchy-system-lock"), { description = "Lock system" })'
append_lua '  hl.bind("switch:on:Lid Switch", hl.dsp.exec_cmd("omarchy-system-lid-close"), { locked = true })'
append_lua '  hl.bind("switch:off:Lid Switch", hl.dsp.exec_cmd("omarchy-hyprland-monitor-clamshell"), { locked = true })'

lua_program="$lua_program
end)
hl.dispatch(hl.dsp.submap(\"omarchy-kids\"))
assert(hl.get_current_submap() == \"omarchy-kids\", \"Kids Mode submap did not activate\")"

# Mark ownership before applying. If the shell disappears mid-transition, the
# next service instance knows to reload the real configuration before retrying.
printf 'version=1\n' >"$ACTIVE_MARKER"
if ! error=$($HYPRCTL_BIN eval "$lua_program" 2>&1); then
  restore_error=""
  if reload_bindings >/dev/null 2>&1; then
    rm -f -- "$ACTIVE_MARKER"
  else
    restore_error="; automatic restore also failed"
  fi
  json_result enter false "$changed" false \
    "Could not apply Kids Mode shortcuts: $error$restore_error"
  exit 1
fi

json_result enter true "$changed" false
