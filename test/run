#!/bin/bash

set -Eeuo pipefail

PLUGIN_ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
MANIFEST="$PLUGIN_ROOT/manifest.json"
MENU="$PLUGIN_ROOT/kids-menu.jsonc"
EMPTY_MENU="$PLUGIN_ROOT/empty-menu.jsonc"
WINDOW_SESSION="$PLUGIN_ROOT/window-session"
SHORTCUT_POLICY="$PLUGIN_ROOT/shortcut-policy"
LIFECYCLE_CLEANUP="$PLUGIN_ROOT/lifecycle-cleanup"

bash -n "$PLUGIN_ROOT/test/run" "$PLUGIN_ROOT/test/vm-acceptance" \
  "$PLUGIN_ROOT/test/hyprctl-mock" "$PLUGIN_ROOT/test/keybindings-mock" \
  "$PLUGIN_ROOT/test/window-hyprctl-mock" \
  "$WINDOW_SESSION" "$SHORTCUT_POLICY" "$LIFECYCLE_CLEANUP"

fail() {
  echo "FAIL: $*" >&2
  exit 1
}

[[ -f $PLUGIN_ROOT/LICENSE ]] || fail "repository license is missing"

rg -q '^## Remove$' "$PLUGIN_ROOT/README.md" \
  && rg -Fq 'omarchy plugin remove io.github.elgevan.omarchy-kids' "$PLUGIN_ROOT/README.md" \
  || fail "README does not include standard plugin removal instructions"

jq -e '
  .schemaVersion == 1 and
  .id == "io.github.elgevan.omarchy-kids" and
  .name == "Omarchy Kids Mode" and
  .version == "0.15.1" and
  .author == "elgevan" and
  .description == "Temporarily switch your Omarchy desktop into a simpler space for a child, with only the apps you choose and a separate, persistent browser profile." and
  .kinds == ["menu", "bar-widget", "service"] and
  .entryPoints.menu == "Menu.qml" and
  .entryPoints.barWidget == "BarWidget.qml" and
  .entryPoints.service == "Service.qml" and
  .barWidget.displayName == "Kids Mode" and
  .barWidget.description == "Keeps the normal Omarchy menu button and shows only the apps you choose while Kids Mode is active." and
  (.omarchy? == null)
' "$MANIFEST" >/dev/null || fail "manifest does not declare a standalone namespaced menu/bar/service plugin"

rg -Fq "Exiting through the Kids Mode panel invokes Omarchy's lock screen" \
    "$PLUGIN_ROOT/README.md" \
  && rg -Fq 'software already running as the same Linux user' \
    "$PLUGIN_ROOT/README.md" \
  && rg -Fq 'No sudo or pkexec is required.' "$PLUGIN_ROOT/README.md" \
  && rg -Fq 'hyprctl`, `jq`, `flock`, Coreutils, and `uwsm-app' \
    "$PLUGIN_ROOT/README.md" \
  || fail "README does not document the authentication boundary and runtime integrations"

jq -e . "$MENU" >/dev/null || fail "Kids Mode menu is not valid JSONC/JSON"
jq -e 'keys | length == 0' "$EMPTY_MENU" >/dev/null || fail "menu extension guard is not empty"

jq -e '
  (keys | sort) == ["apps", "style", "style.background", "style.theme"] and
  .apps.provider == "apps" and
  .apps.label == "Apps" and
  .style.parent == "apps" and
  .style.label == "Style" and
  (.style.when | contains("omarchy-theme")) and
  ([to_entries[] | select(.value.action? != null) | .key] | sort) == ["style.background", "style.theme"]
' "$MENU" >/dev/null || fail "menu is not a flat installed-app provider plus optional Style"

node - "$PLUGIN_ROOT/Allowlist.js" <<'NODE'
const assert = require("node:assert/strict")
const allowlist = require(process.argv[2])

assert.deepEqual(allowlist.defaultIds(), ["chromium", "google-chrome", "omacalc", "omawrite"])
assert.equal(allowlist.parseSettings(""), null)
assert.equal(allowlist.parseSettings("not json"), null)
assert.equal(allowlist.parseSettings(JSON.stringify({version: 2, allowedDesktopIds: ["chromium"]})), null)
assert.deepEqual(
  allowlist.parseSettings(JSON.stringify({version: 1, allowedDesktopIds: []})),
  []
)
assert.deepEqual(
  allowlist.filterRows([
    {entry: {id: "chromium"}},
    {entry: {id: "org.gnome.Nautilus"}},
    {entry: {id: "omawrite.desktop"}}
  ], allowlist.defaultIds()).map(row => row.entry.id),
  ["chromium", "omawrite.desktop"]
)
NODE

node - "$PLUGIN_ROOT/NotificationState.js" <<'NODE'
const assert = require("node:assert/strict")
const state = require(process.argv[2])

assert.deepEqual(state.parseState(""), {managed: false, restoreDnd: false})
assert.deepEqual(state.parseState("not json"), {managed: false, restoreDnd: false})
assert.deepEqual(
  state.parseState(JSON.stringify({version: 1, managed: true, restoreDnd: true})),
  {managed: true, restoreDnd: true}
)
assert.deepEqual(
  JSON.parse(state.stateText(true, false)),
  {version: 1, managed: true, restoreDnd: false}
)
NODE

node - "$PLUGIN_ROOT/ModeState.js" <<'NODE'
const assert = require("node:assert/strict")
const state = require(process.argv[2])

assert.equal(state.parseEnabled(""), false)
assert.equal(state.parseEnabled("not json"), false)
assert.equal(state.parseEnabled(JSON.stringify({version: 1, enabled: false})), false)
assert.equal(state.parseEnabled(JSON.stringify({version: 1, enabled: true})), true)
assert.deepEqual(JSON.parse(state.stateText(true)), {version: 1, enabled: true})
assert.deepEqual(JSON.parse(state.stateText(false)), {version: 1, enabled: false})
assert.deepEqual(JSON.parse(state.stateText()), {version: 1, enabled: false})
NODE

node - "$PLUGIN_ROOT/BarActions.js" <<'NODE'
const assert = require("node:assert/strict")
const actions = require(process.argv[2])

const pluginCommand = route =>
  `omarchy-shell shell toggle io.github.elgevan.omarchy-kids '{"menu":"${route}"}'`

assert.equal(actions.menuRoute(false), "root")
assert.equal(actions.menuRoute(true), "apps")
assert.equal(actions.commandFor(false, false), pluginCommand("root"))
assert.equal(actions.commandFor(true, false), pluginCommand("apps"))
assert.equal(actions.commandFor(false, true), "xdg-terminal-exec")
assert.equal(actions.commandFor(true, true), "")
NODE

node - "$PLUGIN_ROOT/ShellIntegration.js" <<'NODE'
const assert = require("node:assert/strict")
const integration = require(process.argv[2])

const pluginId = "io.github.elgevan.omarchy-kids"
const managerId = pluginId + ".manager"
const managerPath = "/plugins/omarchy-kids/ManagerWidget.qml"
const config = {
  version: 1,
  bar: {
    layout: {
      left: [
        {id: "omarchy.menu", custom: "preserved"},
        {id: "omarchy.workspaces"},
        {id: pluginId}
      ],
      center: [{id: "omarchy.clock", format: "HH:mm"}],
      right: [{id: "omarchy.tray"}, {id: "omarchy.audio", step: 3}]
    }
  },
  plugins: []
}

let result = integration.activate(config, pluginId, managerId, managerPath, true)
assert.deepEqual(config.bar.layout.left.map(integration.entryId), [pluginId])
assert.deepEqual(config.bar.layout.center, [])
assert.deepEqual(
  config.bar.layout.right.map(integration.entryId),
  [managerId, ...integration.KIDS_CONTROL_IDS]
)
assert.equal(config.bar.layout.left[0].kidsMenuRestore.entry.custom, "preserved")
assert.deepEqual(config.bar.layout.right[3], {id: "omarchy.audio", step: 3})
assert.equal(config.bar.layout.right[0].source, managerPath)
assert.deepEqual(
  config.bar.layout.left[0].kidsBarLayoutRestore.center,
  [{id: "omarchy.clock", format: "HH:mm"}]
)
assert.deepEqual(config.disabledPlugins, ["omarchy.menu"])
assert.deepEqual(result.restore, {
  section: "left",
  index: 0,
  entry: {id: "omarchy.menu", custom: "preserved"}
})
assert.deepEqual(result.barRestore.right.map(integration.entryId), [
  "omarchy.tray", managerId, "omarchy.audio"
])

const firstBarRestore = JSON.parse(JSON.stringify(result.barRestore))
result = integration.activate(config, pluginId, managerId, managerPath, true)
assert.deepEqual(result.barRestore, firstBarRestore)
assert.deepEqual(
  config.bar.layout.right.map(integration.entryId),
  [managerId, ...integration.KIDS_CONTROL_IDS]
)

result = integration.activate(config, pluginId, managerId, managerPath, false)
assert.deepEqual(config.bar.layout.left.map(integration.entryId), [pluginId, "omarchy.workspaces"])
assert.deepEqual(config.bar.layout.center, [{id: "omarchy.clock", format: "HH:mm"}])
assert.deepEqual(config.bar.layout.right.map(integration.entryId), [
  "omarchy.tray", managerId, "omarchy.audio"
])
assert.equal(config.bar.layout.right[2].step, 3)
assert.equal(config.bar.layout.left[0].kidsBarLayoutRestore, undefined)
assert.equal(config.disabledPlugins, undefined)
assert.equal(result.barRestore, null)

config.bar.layout.left = config.bar.layout.left.filter(entry => integration.entryId(entry) !== pluginId)
integration.deactivate(config, pluginId, managerId, result.restore, result.barRestore)
assert.deepEqual(config.bar.layout.left.map(integration.entryId), ["omarchy.menu", "omarchy.workspaces"])
assert.equal(config.bar.layout.left[0].custom, "preserved")
assert.deepEqual(config.bar.layout.center, [{id: "omarchy.clock", format: "HH:mm"}])
assert.deepEqual(config.bar.layout.right, [{id: "omarchy.tray"}, {id: "omarchy.audio", step: 3}])
assert.equal(integration.barLocation(config, managerId), null)
assert.equal(config.disabledPlugins, undefined)

const removalConfig = {
  version: 1,
  bar: {
    layout: {
      left: [
        {id: "omarchy.menu", custom: "preserved"},
        {id: "omarchy.workspaces"},
        {id: pluginId}
      ],
      center: [{id: "omarchy.clock"}],
      right: [{id: "omarchy.tray"}, {id: "omarchy.audio", step: 3}]
    }
  },
  plugins: []
}
result = integration.activate(removalConfig, pluginId, managerId, managerPath, true)
integration.deactivate(
  removalConfig,
  pluginId,
  managerId,
  result.restore,
  result.barRestore
)
assert.deepEqual(removalConfig.bar.layout.left.map(integration.entryId), [
  "omarchy.menu", "omarchy.workspaces"
])
assert.deepEqual(removalConfig.bar.layout.center, [{id: "omarchy.clock"}])
assert.deepEqual(removalConfig.bar.layout.right, [
  {id: "omarchy.tray"}, {id: "omarchy.audio", step: 3}
])
assert.equal(integration.barLocation(removalConfig, pluginId), null)
assert.equal(integration.barLocation(removalConfig, managerId), null)
assert.equal(removalConfig.disabledPlugins, undefined)

const customConfig = {
  version: 1,
  bar: {
    layout: {
      left: [{id: pluginId}, {id: "omarchy.workspaces"}, {id: "omarchy.menu"}],
      center: [],
      right: []
    }
  },
  plugins: []
}
result = integration.activate(customConfig, pluginId, managerId, managerPath, true)
assert.deepEqual(customConfig.bar.layout.left.map(integration.entryId), [pluginId])
assert.deepEqual(
  customConfig.bar.layout.right.map(integration.entryId),
  [managerId, ...integration.KIDS_CONTROL_IDS]
)
assert.equal(result.restore.index, 1)

const noStockConfig = {
  version: 1,
  bar: {layout: {left: [{id: pluginId}], center: [], right: []}},
  plugins: []
}
result = integration.activate(noStockConfig, pluginId, managerId, managerPath, true)
assert.equal(result.restore, null)
integration.deactivate(
  noStockConfig,
  pluginId,
  managerId,
  result.restore,
  result.barRestore
)
assert.equal(integration.barLocation(noStockConfig, "omarchy.menu"), null)
assert.deepEqual(noStockConfig.bar.layout, {left: [], center: [], right: []})

assert.equal(integration.normalizedBarRestore({left: [], center: []}), null)
assert.equal(integration.normalizedBarRestore({left: [], center: [], right: "bad"}), null)
NODE

node - "$PLUGIN_ROOT/KidsBrowser.js" <<'NODE'
const assert = require("node:assert/strict")
const browser = require(process.argv[2])

assert.equal(browser.isChromium("chromium"), true)
assert.equal(browser.isChromium("chromium.desktop"), true)
assert.equal(browser.isChromium("google-chrome"), false)
assert.equal(browser.isBrowser("chromium"), true)
assert.equal(browser.isBrowser("google-chrome.desktop"), true)
assert.equal(browser.isBrowser("google-chrome-stable"), true)
assert.equal(browser.isBrowser("firefox"), false)
assert.equal(
  browser.webAppUrl(["omarchy-launch-webapp", "https://youtube.com/"]),
  "https://youtube.com/"
)
assert.equal(
  browser.webAppUrl(["/usr/bin/omarchy-launch-webapp", "https://music.youtube.com", "--new-window"]),
  "https://music.youtube.com"
)
assert.equal(browser.webAppUrl(["omarchy-launch-webapp", "file:///tmp/not-web"]), "")
assert.equal(browser.webAppUrl(["chromium", "https://youtube.com/"]), "")
assert.equal(
  browser.webAppUrl([], "omarchy-launch-webapp https://youtube.com/"),
  "https://youtube.com/"
)
assert.equal(
  browser.webAppUrl([], "/usr/bin/omarchy-launch-webapp 'https://music.youtube.com' --new-window"),
  "https://music.youtube.com"
)
assert.equal(browser.webAppUrl([], "chromium https://youtube.com/"), "")
assert.equal(browser.profileDir("/home/kid/"), "/home/kid/.local/share/omarchy-kids/chromium")
assert.deepEqual(browser.launchCommand("/home/kid"), [
  "uwsm-app",
  "--",
  "/usr/bin/chromium",
  "--user-data-dir=/home/kid/.local/share/omarchy-kids/chromium",
  "--no-first-run",
  "--no-default-browser-check",
  "--disable-sync",
  "--new-window"
])
assert.deepEqual(browser.launchCommand("/home/kid", "https://youtube.com/"), [
  "uwsm-app",
  "--",
  "/usr/bin/chromium",
  "--user-data-dir=/home/kid/.local/share/omarchy-kids/chromium",
  "--no-first-run",
  "--no-default-browser-check",
  "--disable-sync",
  "--app=https://youtube.com/"
])
NODE

[[ -x $WINDOW_SESSION ]] || fail "window-session helper is not executable"
[[ -x $SHORTCUT_POLICY ]] || fail "shortcut-policy helper is not executable"
[[ -x $LIFECYCLE_CLEANUP ]] || fail "lifecycle-cleanup helper is not executable"
rg -q 'runtimeToolDir: runtimeRoot \+ "/omarchy-kids/tools"' "$PLUGIN_ROOT/Service.qml" \
  && rg -q '"cp", "--"' "$PLUGIN_ROOT/Service.qml" \
  && rg -q 'id: stageRuntimeTools' "$PLUGIN_ROOT/Service.qml" \
  && rg -q 'windowSessionTool: runtimeToolsReady' "$PLUGIN_ROOT/Service.qml" \
  && rg -q 'shortcutPolicyTool: runtimeToolsReady' "$PLUGIN_ROOT/Service.qml" \
  && rg -q 'lifecycleCleanupTool: runtimeToolsReady' "$PLUGIN_ROOT/Service.qml" \
  && rg -q 'root\.lifecycleCleanupTool,' "$PLUGIN_ROOT/Service.qml" \
  || fail "cleanup helpers are not staged outside the removable plugin checkout"
window_test_dir=$(mktemp -d)
window_log=$window_test_dir/hyprctl.log
window_mock=$PLUGIN_ROOT/test/window-hyprctl-mock
window_clients=$PLUGIN_ROOT/test/fixtures/window-clients.json
window_clients_missing=$PLUGIN_ROOT/test/fixtures/window-clients-missing.json
window_clients_missing_restored=$PLUGIN_ROOT/test/fixtures/window-clients-missing-restored.json
window_clients_kids=$PLUGIN_ROOT/test/fixtures/window-clients-kids.json
window_clients_closed=$PLUGIN_ROOT/test/fixtures/window-clients-closed.json
window_clients_close_refused=$PLUGIN_ROOT/test/fixtures/window-clients-close-refused.json
window_clients_address_reused=$PLUGIN_ROOT/test/fixtures/window-clients-address-reused.json
window_clients_address_reused_closed=$PLUGIN_ROOT/test/fixtures/window-clients-address-reused-closed.json
window_clients_misdirected=$PLUGIN_ROOT/test/fixtures/window-clients-misdirected.json
window_active=$PLUGIN_ROOT/test/fixtures/window-active.json
window_workspace=$PLUGIN_ROOT/test/fixtures/window-workspace.json
window_monitors=$PLUGIN_ROOT/test/fixtures/window-monitors.json
window_monitors_hotplug=$PLUGIN_ROOT/test/fixtures/window-monitors-hotplug.json
window_workspaces=$PLUGIN_ROOT/test/fixtures/window-workspaces.json
window_workspaces_kids=$PLUGIN_ROOT/test/fixtures/window-workspaces-kids.json
window_workspace_fallback=$PLUGIN_ROOT/test/fixtures/window-workspace-fallback.json
export OMARCHY_KIDS_TEST_MONITORS=$window_monitors
export OMARCHY_KIDS_TEST_WORKSPACES=$window_workspaces
window_status=$(
  HYPRLAND_INSTANCE_SIGNATURE=test-instance \
    XDG_STATE_HOME="$window_test_dir" \
    "$WINDOW_SESSION" status
)
jq -e '.action == "status" and .status == "inactive" and .hidden == 0' \
  <<< "$window_status" >/dev/null \
  || fail "window-session helper does not report a clean inactive state"

window_collision_dir=$(mktemp -d)
collision_log=$window_collision_dir/hyprctl.log
if window_result=$(
  HYPRLAND_INSTANCE_SIGNATURE=test-instance \
    XDG_STATE_HOME="$window_collision_dir" \
    OMARCHY_KIDS_HYPRCTL="$window_mock" \
    OMARCHY_KIDS_TEST_CLIENTS="$window_clients" \
    OMARCHY_KIDS_TEST_ACTIVE_WINDOW="$window_active" \
    OMARCHY_KIDS_TEST_ACTIVE_WORKSPACE="$window_workspace" \
    OMARCHY_KIDS_TEST_WORKSPACES="$window_workspaces_kids" \
    OMARCHY_KIDS_TEST_WINDOW_LOG="$collision_log" \
    "$WINDOW_SESSION" enter
); then
  fail "window-session helper accepts an existing Kids workspace"
fi
jq -e '.action == "enter" and .status == "workspace-in-use" and .failed == 1' \
  <<< "$window_result" >/dev/null \
  && [[ ! -f $window_collision_dir/omarchy-kids/windows.json ]] \
  && [[ ! -s $collision_log ]] \
  || fail "window-session helper does not reject a workspace name collision safely"
rm -rf -- "$window_collision_dir"

window_result=$(
  HYPRLAND_INSTANCE_SIGNATURE=test-instance \
    XDG_STATE_HOME="$window_test_dir" \
    OMARCHY_KIDS_HYPRCTL="$window_mock" \
    OMARCHY_KIDS_TEST_CLIENTS="$window_clients" \
    OMARCHY_KIDS_TEST_ACTIVE_WINDOW="$window_active" \
    OMARCHY_KIDS_TEST_ACTIVE_WORKSPACE="$window_workspace" \
    OMARCHY_KIDS_TEST_WINDOW_LOG="$window_log" \
    "$WINDOW_SESSION" enter
)
jq -e '.action == "enter" and .status == "active" and .hidden == 2
  and .expected == 2 and .failed == 0' <<< "$window_result" >/dev/null \
  && jq -e '.originalActiveWorkspace == "work"
    and .originalActiveMonitor == "DP-2"' \
    "$window_test_dir/omarchy-kids/windows.json" >/dev/null \
  || fail "window-session helper does not confirm every hidden window"

if window_result=$(
  HYPRLAND_INSTANCE_SIGNATURE=test-instance \
    XDG_STATE_HOME="$window_test_dir" \
    OMARCHY_KIDS_HYPRCTL="$window_mock" \
    OMARCHY_KIDS_TEST_CLIENTS="$window_clients" \
    OMARCHY_KIDS_TEST_ACTIVE_WINDOW="$window_active" \
    OMARCHY_KIDS_TEST_ACTIVE_WORKSPACE="$window_workspace" \
    OMARCHY_KIDS_TEST_WINDOW_LOG="$window_log" \
    OMARCHY_KIDS_TEST_FAIL_MOVE_ADDRESS=0xbbb \
    "$WINDOW_SESSION" exit
); then
  fail "window-session helper accepts a partial restore"
fi
jq -e '.action == "exit" and .status == "restore-failed"
  and .restored == 0 and .failed > 0' <<< "$window_result" >/dev/null \
  && jq -e '.active == true and .status == "restore-failed"' \
    "$window_test_dir/omarchy-kids/windows.json" >/dev/null \
  || fail "window-session helper does not retain a failed restore for retry"
[[ $(rg -c 'special:omarchy-kids-parent.*address:0xaaa' "$window_log") -ge 2 ]] \
  || fail "window-session helper does not compensate a partial restore"

if window_result=$(
  HYPRLAND_INSTANCE_SIGNATURE=test-instance \
    XDG_STATE_HOME="$window_test_dir" \
    OMARCHY_KIDS_HYPRCTL="$window_mock" \
    OMARCHY_KIDS_TEST_CLIENTS="$window_clients" \
    OMARCHY_KIDS_TEST_ACTIVE_WINDOW="$window_active" \
    OMARCHY_KIDS_TEST_ACTIVE_WORKSPACE="$window_workspace" \
    OMARCHY_KIDS_TEST_WINDOW_LOG="$window_log" \
    "$WINDOW_SESSION" enter
); then
  fail "window-session helper accepts an incomplete active snapshot"
fi
jq -e '.action == "enter" and .status == "incomplete-session"
  and .failed == 1' <<< "$window_result" >/dev/null \
  || fail "window-session helper does not reject an incomplete active snapshot"

window_result=$(
  HYPRLAND_INSTANCE_SIGNATURE=test-instance \
    XDG_STATE_HOME="$window_test_dir" \
    OMARCHY_KIDS_HYPRCTL="$window_mock" \
    OMARCHY_KIDS_TEST_CLIENTS="$window_clients" \
    OMARCHY_KIDS_TEST_ACTIVE_WINDOW="$window_active" \
    OMARCHY_KIDS_TEST_ACTIVE_WORKSPACE="$window_workspace" \
    OMARCHY_KIDS_TEST_WINDOW_LOG="$window_log" \
    "$WINDOW_SESSION" exit
)
jq -e '.action == "exit" and .status == "restored" and .restored == 2
  and .missing == 0 and .failed == 0' <<< "$window_result" >/dev/null \
  && jq -e '.active == false and .status == "restored"' \
    "$window_test_dir/omarchy-kids/windows.json" >/dev/null \
  || fail "window-session helper cannot complete a retried restore"

window_focus_dir=$(mktemp -d)
focus_log=$window_focus_dir/hyprctl.log
HYPRLAND_INSTANCE_SIGNATURE=test-instance \
  XDG_STATE_HOME="$window_focus_dir" \
  OMARCHY_KIDS_HYPRCTL="$window_mock" \
  OMARCHY_KIDS_TEST_CLIENTS="$window_clients" \
  OMARCHY_KIDS_TEST_ACTIVE_WINDOW="$window_active" \
  OMARCHY_KIDS_TEST_ACTIVE_WORKSPACE="$window_workspace" \
  OMARCHY_KIDS_TEST_WINDOW_LOG="$focus_log" \
  "$WINDOW_SESSION" enter >/dev/null
if window_result=$(
  HYPRLAND_INSTANCE_SIGNATURE=test-instance \
    XDG_STATE_HOME="$window_focus_dir" \
    OMARCHY_KIDS_HYPRCTL="$window_mock" \
    OMARCHY_KIDS_TEST_CLIENTS="$window_clients" \
    OMARCHY_KIDS_TEST_ACTIVE_WINDOW="$window_active" \
    OMARCHY_KIDS_TEST_ACTIVE_WORKSPACE="$window_workspace" \
    OMARCHY_KIDS_TEST_WINDOW_LOG="$focus_log" \
    OMARCHY_KIDS_TEST_FAIL_WINDOW_FOCUS=true \
    "$WINDOW_SESSION" exit
); then
  fail "window-session helper accepts an original-window focus failure"
fi
jq -e '.status == "restore-failed" and .failed > 0' \
  <<< "$window_result" >/dev/null \
  && tail -n 1 "$focus_log" | rg -Fq 'workspace = "name:omarchy-kids"' \
  || fail "window-session helper does not return to Kids workspace after compensation"
HYPRLAND_INSTANCE_SIGNATURE=test-instance \
  XDG_STATE_HOME="$window_focus_dir" \
  OMARCHY_KIDS_HYPRCTL="$window_mock" \
  OMARCHY_KIDS_TEST_CLIENTS="$window_clients" \
  OMARCHY_KIDS_TEST_ACTIVE_WINDOW="$window_active" \
  OMARCHY_KIDS_TEST_ACTIVE_WORKSPACE="$window_workspace" \
  OMARCHY_KIDS_TEST_WINDOW_LOG="$focus_log" \
  "$WINDOW_SESSION" exit >/dev/null
rm -rf -- "$window_focus_dir"

window_missing_dir=$(mktemp -d)
missing_marker=$window_missing_dir/client-query.marker
HYPRLAND_INSTANCE_SIGNATURE=test-instance \
  XDG_STATE_HOME="$window_missing_dir" \
  OMARCHY_KIDS_HYPRCTL="$window_mock" \
  OMARCHY_KIDS_TEST_CLIENTS="$window_clients" \
  OMARCHY_KIDS_TEST_ACTIVE_WINDOW="$window_active" \
  OMARCHY_KIDS_TEST_ACTIVE_WORKSPACE="$window_workspace" \
  OMARCHY_KIDS_TEST_WINDOW_LOG="$window_log" \
  "$WINDOW_SESSION" enter >/dev/null
window_result=$(
  HYPRLAND_INSTANCE_SIGNATURE=test-instance \
    XDG_STATE_HOME="$window_missing_dir" \
    OMARCHY_KIDS_HYPRCTL="$window_mock" \
    OMARCHY_KIDS_TEST_CLIENTS="$window_clients_missing" \
    OMARCHY_KIDS_TEST_POST_CLIENTS="$window_clients_missing_restored" \
    OMARCHY_KIDS_TEST_CLIENTS_MARKER="$missing_marker" \
    OMARCHY_KIDS_TEST_ACTIVE_WINDOW="$window_active" \
    OMARCHY_KIDS_TEST_ACTIVE_WORKSPACE="$window_workspace" \
    OMARCHY_KIDS_TEST_WINDOW_LOG="$window_log" \
    "$WINDOW_SESSION" exit
)
jq -e '.status == "restored" and .expected == 2 and .live == 1
  and .restored == 1 and .missing == 1 and .failed == 0
  and .kidsRemaining == 0 and .workspaceRemoved == true' \
  <<< "$window_result" >/dev/null \
  || fail "window-session helper does not distinguish closed windows from restore failures"

window_multi_dir=$(mktemp -d)
multi_log=$window_multi_dir/hyprctl.log
multi_marker=$window_multi_dir/client-query.marker
HYPRLAND_INSTANCE_SIGNATURE=test-instance \
  XDG_STATE_HOME="$window_multi_dir" \
  OMARCHY_KIDS_HYPRCTL="$window_mock" \
  OMARCHY_KIDS_TEST_CLIENTS="$window_clients" \
  OMARCHY_KIDS_TEST_ACTIVE_WINDOW="$window_active" \
  OMARCHY_KIDS_TEST_ACTIVE_WORKSPACE="$window_workspace" \
  OMARCHY_KIDS_TEST_WINDOW_LOG="$multi_log" \
  "$WINDOW_SESSION" enter >/dev/null
window_result=$(
  HYPRLAND_INSTANCE_SIGNATURE=test-instance \
    XDG_STATE_HOME="$window_multi_dir" \
    OMARCHY_KIDS_HYPRCTL="$window_mock" \
    OMARCHY_KIDS_TEST_CLIENTS="$window_clients_kids" \
    OMARCHY_KIDS_TEST_POST_CLIENTS="$window_clients_closed" \
    OMARCHY_KIDS_TEST_EXPECT_CLOSE_COUNT=3 \
    OMARCHY_KIDS_TEST_CLIENTS_MARKER="$multi_marker" \
    OMARCHY_KIDS_TEST_ACTIVE_WINDOW="$window_active" \
    OMARCHY_KIDS_TEST_ACTIVE_WORKSPACE="$window_workspace" \
    OMARCHY_KIDS_TEST_WINDOW_LOG="$multi_log" \
    "$WINDOW_SESSION" exit
)
jq -e '.status == "restored" and .expected == 2 and .restored == 2
  and .evacuated == 3 and .kidsRemaining == 0
  and .workspaceRemoved == true and .failed == 0' \
  <<< "$window_result" >/dev/null \
  && jq -e '.active == false and .status == "restored"
    and .originalActiveMonitor == "DP-2" and .workspaceRemoved == true' \
    "$window_multi_dir/omarchy-kids/windows.json" >/dev/null \
  || fail "window-session helper does not close Kids-launched windows"
rg -q 'hl\.dsp\.window\.close.*address:0xccc' "$multi_log" \
  && rg -q 'hl\.dsp\.window\.close.*address:0xddd' "$multi_log" \
  && rg -q 'hl\.dsp\.window\.close.*address:0xeee' "$multi_log" \
  && ! rg -q 'hl\.dsp\.window\.move.*address:0x(ccc|ddd|eee)' "$multi_log" \
  && ! rg -q 'hl\.dsp\.window\.close.*address:0x(aaa|bbb|fff)' "$multi_log" \
  || fail "window-session helper closes the wrong post-entry windows"
monitor_focus_line=$(rg -nF 'hl.dsp.focus({ monitor = "DP-2" })' "$multi_log" \
  | tail -1 | cut -d: -f1)
workspace_focus_line=$(rg -nF 'hl.dsp.focus({ workspace = "name:work" })' "$multi_log" \
  | tail -1 | cut -d: -f1)
[[ -n $monitor_focus_line && -n $workspace_focus_line \
    && $monitor_focus_line -lt $workspace_focus_line ]] \
  || fail "window-session helper does not restore the original monitor before its workspace"

