#!/bin/bash

set -Eeuo pipefail

PLUGIN_ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
MANIFEST="$PLUGIN_ROOT/manifest.json"
MENU="$PLUGIN_ROOT/kids-menu.jsonc"
EMPTY_MENU="$PLUGIN_ROOT/empty-menu.jsonc"
WINDOW_SESSION="$PLUGIN_ROOT/window-session"
SHORTCUT_POLICY="$PLUGIN_ROOT/shortcut-policy"
LIFECYCLE_CLEANUP="$PLUGIN_ROOT/lifecycle-cleanup"

bash -n "$PLUGIN_ROOT/test/run" "$PLUGIN_ROOT/test/vm-acceptance" \
  "$PLUGIN_ROOT/test/hyprctl-mock" "$PLUGIN_ROOT/test/keybindings-mock" \
  "$PLUGIN_ROOT/test/window-hyprctl-mock" \
  "$WINDOW_SESSION" "$SHORTCUT_POLICY" "$LIFECYCLE_CLEANUP"

fail() {
  echo "FAIL: $*" >&2
  exit 1
}

[[ -f $PLUGIN_ROOT/LICENSE ]] || fail "repository license is missing"

rg -q '^## Remove$' "$PLUGIN_ROOT/README.md" \
  && rg -Fq 'omarchy plugin remove io.github.elgevan.omarchy-kids' "$PLUGIN_ROOT/README.md" \
  || fail "README does not include standard plugin removal instructions"

jq -e '
  .schemaVersion == 1 and
  .id == "io.github.elgevan.omarchy-kids" and
  .version == "0.14.0" and
  .kinds == ["menu", "bar-widget", "service"] and
  .entryPoints.menu == "Menu.qml" and
  .entryPoints.barWidget == "BarWidget.qml" and
  .entryPoints.service == "Service.qml" and
  (.omarchy? == null)
' "$MANIFEST" >/dev/null || fail "manifest does not declare a standalone namespaced menu/bar/service plugin"

jq -e . "$MENU" >/dev/null || fail "kids menu is not valid JSONC/JSON"
jq -e 'keys | length == 0' "$EMPTY_MENU" >/dev/null || fail "menu extension guard is not empty"

jq -e '
  (keys | sort) == ["apps", "style", "style.background", "style.theme"] and
  .apps.provider == "apps" and
  .style.parent == "apps" and
  .style.label == "Style" and
  (.style.when | contains("omarchy-theme")) and
  ([to_entries[] | select(.value.action? != null) | .key] | sort) == ["style.background", "style.theme"]
' "$MENU" >/dev/null || fail "menu is not a flat installed-app provider plus optional Style"

node - "$PLUGIN_ROOT/Allowlist.js" <<'NODE'
const assert = require("node:assert/strict")
const allowlist = require(process.argv[2])

assert.deepEqual(allowlist.defaultIds(), ["chromium", "google-chrome", "omacalc", "omawrite"])
assert.deepEqual(allowlist.parseSettings("not json"), allowlist.defaultIds())
assert.deepEqual(
  allowlist.parseSettings(JSON.stringify({version: 1, allowedDesktopIds: []})),
  []
)
assert.deepEqual(
  allowlist.filterRows([
    {entry: {id: "chromium"}},
    {entry: {id: "org.gnome.Nautilus"}},
    {entry: {id: "omawrite.desktop"}}
  ], allowlist.defaultIds()).map(row => row.entry.id),
  ["chromium", "omawrite.desktop"]
)
NODE

node - "$PLUGIN_ROOT/NotificationState.js" <<'NODE'
const assert = require("node:assert/strict")
const state = require(process.argv[2])

assert.deepEqual(state.parseState(""), {managed: false, restoreDnd: false})
assert.deepEqual(state.parseState("not json"), {managed: false, restoreDnd: false})
assert.deepEqual(
  state.parseState(JSON.stringify({version: 1, managed: true, restoreDnd: true})),
  {managed: true, restoreDnd: true}
)
assert.deepEqual(
  JSON.parse(state.stateText(true, false)),
  {version: 1, managed: true, restoreDnd: false}
)
NODE

node - "$PLUGIN_ROOT/ModeState.js" <<'NODE'
const assert = require("node:assert/strict")
const state = require(process.argv[2])

assert.equal(state.parseEnabled(""), false)
assert.equal(state.parseEnabled("not json"), false)
assert.equal(state.parseEnabled(JSON.stringify({version: 1, enabled: false})), false)
assert.equal(state.parseEnabled(JSON.stringify({version: 1, enabled: true})), true)
assert.deepEqual(JSON.parse(state.stateText(true)), {version: 1, enabled: true})
assert.deepEqual(JSON.parse(state.stateText(false)), {version: 1, enabled: false})
assert.deepEqual(JSON.parse(state.stateText()), {version: 1, enabled: false})
NODE

node - "$PLUGIN_ROOT/ShellIntegration.js" <<'NODE'
const assert = require("node:assert/strict")
const integration = require(process.argv[2])

const pluginId = "io.github.elgevan.omarchy-kids"
const managerId = pluginId + ".manager"
const managerPath = "/plugins/omarchy-kids/ManagerWidget.qml"
const config = {
  version: 1,
  bar: {
    layout: {
      left: [
        {id: "omarchy.menu", custom: "preserved"},
        {id: "omarchy.workspaces"},
        {id: pluginId}
      ],
      center: [],
      right: [{id: "omarchy.tray"}, {id: "omarchy.audio"}]
    }
  },
  plugins: []
}

let result = integration.activate(config, pluginId, managerId, managerPath, true)
assert.deepEqual(config.bar.layout.left.map(integration.entryId), [pluginId, "omarchy.workspaces"])
assert.equal(config.bar.layout.left[0].kidsMenuRestore.entry.custom, "preserved")
assert.equal(config.bar.layout.right[1].id, managerId)
assert.equal(config.bar.layout.right[1].source, managerPath)
assert.deepEqual(config.disabledPlugins, ["omarchy.menu"])
assert.deepEqual(result.restore, {
  section: "left",
  index: 0,
  entry: {id: "omarchy.menu", custom: "preserved"}
})

result = integration.activate(config, pluginId, managerId, managerPath, false)
assert.equal(config.bar.layout.left.filter(entry => integration.entryId(entry) === pluginId).length, 1)
assert.equal(config.bar.layout.right.filter(entry => integration.entryId(entry) === managerId).length, 1)
assert.equal(config.disabledPlugins, undefined)

config.bar.layout.left = config.bar.layout.left.filter(entry => integration.entryId(entry) !== pluginId)
integration.deactivate(config, managerId, result.restore)
assert.deepEqual(config.bar.layout.left.map(integration.entryId), ["omarchy.menu", "omarchy.workspaces"])
assert.equal(config.bar.layout.left[0].custom, "preserved")
assert.equal(integration.barLocation(config, managerId), null)
assert.equal(config.disabledPlugins, undefined)

const customConfig = {
  version: 1,
  bar: {
    layout: {
      left: [{id: pluginId}, {id: "omarchy.workspaces"}, {id: "omarchy.menu"}],
      center: [],
      right: []
    }
  },
  plugins: []
}
result = integration.activate(customConfig, pluginId, managerId, managerPath, true)
assert.deepEqual(customConfig.bar.layout.left.map(integration.entryId), ["omarchy.workspaces", pluginId])
assert.equal(result.restore.index, 1)

const noStockConfig = {
  version: 1,
  bar: {layout: {left: [{id: pluginId}], center: [], right: []}},
  plugins: []
}
result = integration.activate(noStockConfig, pluginId, managerId, managerPath, true)
assert.equal(result.restore, null)
noStockConfig.bar.layout.left = []
integration.deactivate(noStockConfig, managerId, result.restore)
assert.equal(integration.barLocation(noStockConfig, "omarchy.menu"), null)
NODE

node - "$PLUGIN_ROOT/KidsBrowser.js" <<'NODE'
const assert = require("node:assert/strict")
const browser = require(process.argv[2])

assert.equal(browser.isChromium("chromium"), true)
assert.equal(browser.isChromium("chromium.desktop"), true)
assert.equal(browser.isChromium("google-chrome"), false)
assert.equal(browser.isBrowser("chromium"), true)
assert.equal(browser.isBrowser("google-chrome.desktop"), true)
assert.equal(browser.isBrowser("google-chrome-stable"), true)
assert.equal(browser.isBrowser("firefox"), false)
assert.equal(
  browser.webAppUrl(["omarchy-launch-webapp", "https://youtube.com/"]),
  "https://youtube.com/"
)
assert.equal(
  browser.webAppUrl(["/usr/bin/omarchy-launch-webapp", "https://music.youtube.com", "--new-window"]),
  "https://music.youtube.com"
)
assert.equal(browser.webAppUrl(["omarchy-launch-webapp", "file:///tmp/not-web"]), "")
assert.equal(browser.webAppUrl(["chromium", "https://youtube.com/"]), "")
assert.equal(
  browser.webAppUrl([], "omarchy-launch-webapp https://youtube.com/"),
  "https://youtube.com/"
)
assert.equal(
  browser.webAppUrl([], "/usr/bin/omarchy-launch-webapp 'https://music.youtube.com' --new-window"),
  "https://music.youtube.com"
)
assert.equal(browser.webAppUrl([], "chromium https://youtube.com/"), "")
assert.equal(browser.profileDir("/home/kid/"), "/home/kid/.local/share/omarchy-kids/chromium")
assert.deepEqual(browser.launchCommand("/home/kid"), [
  "uwsm-app",
  "--",
  "/usr/bin/chromium",
  "--user-data-dir=/home/kid/.local/share/omarchy-kids/chromium",
  "--no-first-run",
  "--no-default-browser-check",
  "--disable-sync",
  "--new-window"
])
assert.deepEqual(browser.launchCommand("/home/kid", "https://youtube.com/"), [
  "uwsm-app",
  "--",
  "/usr/bin/chromium",
  "--user-data-dir=/home/kid/.local/share/omarchy-kids/chromium",
  "--no-first-run",
  "--no-default-browser-check",
  "--disable-sync",
  "--app=https://youtube.com/"
])
NODE

[[ -x $WINDOW_SESSION ]] || fail "window-session helper is not executable"
[[ -x $SHORTCUT_POLICY ]] || fail "shortcut-policy helper is not executable"
[[ -x $LIFECYCLE_CLEANUP ]] || fail "lifecycle-cleanup helper is not executable"
rg -q 'runtimeToolDir: runtimeRoot \+ "/omarchy-kids/tools"' "$PLUGIN_ROOT/Service.qml" \
  && rg -q '"cp", "--"' "$PLUGIN_ROOT/Service.qml" \
  && rg -q 'id: stageRuntimeTools' "$PLUGIN_ROOT/Service.qml" \
  && rg -q 'windowSessionTool: runtimeToolsReady' "$PLUGIN_ROOT/Service.qml" \
  && rg -q 'shortcutPolicyTool: runtimeToolsReady' "$PLUGIN_ROOT/Service.qml" \
  && rg -q 'lifecycleCleanupTool: runtimeToolsReady' "$PLUGIN_ROOT/Service.qml" \
  && rg -q 'root\.lifecycleCleanupTool,' "$PLUGIN_ROOT/Service.qml" \
  || fail "cleanup helpers are not staged outside the removable plugin checkout"
window_test_dir=$(mktemp -d)
window_log=$window_test_dir/hyprctl.log
window_mock=$PLUGIN_ROOT/test/window-hyprctl-mock
window_clients=$PLUGIN_ROOT/test/fixtures/window-clients.json
window_clients_missing=$PLUGIN_ROOT/test/fixtures/window-clients-missing.json
window_clients_missing_restored=$PLUGIN_ROOT/test/fixtures/window-clients-missing-restored.json
window_clients_kids=$PLUGIN_ROOT/test/fixtures/window-clients-kids.json
window_clients_misdirected=$PLUGIN_ROOT/test/fixtures/window-clients-misdirected.json
window_clients_restored=$PLUGIN_ROOT/test/fixtures/window-clients-restored.json
window_active=$PLUGIN_ROOT/test/fixtures/window-active.json
window_workspace=$PLUGIN_ROOT/test/fixtures/window-workspace.json
window_monitors=$PLUGIN_ROOT/test/fixtures/window-monitors.json
window_monitors_hotplug=$PLUGIN_ROOT/test/fixtures/window-monitors-hotplug.json
window_workspaces=$PLUGIN_ROOT/test/fixtures/window-workspaces.json
window_workspaces_kids=$PLUGIN_ROOT/test/fixtures/window-workspaces-kids.json
window_workspace_fallback=$PLUGIN_ROOT/test/fixtures/window-workspace-fallback.json
export OMARCHY_KIDS_TEST_MONITORS=$window_monitors
export OMARCHY_KIDS_TEST_WORKSPACES=$window_workspaces
window_status=$(
  HYPRLAND_INSTANCE_SIGNATURE=test-instance \
    XDG_STATE_HOME="$window_test_dir" \
    "$WINDOW_SESSION" status
)
jq -e '.action == "status" and .status == "inactive" and .hidden == 0' \
  <<< "$window_status" >/dev/null \
  || fail "window-session helper does not report a clean inactive state"

window_result=$(
  HYPRLAND_INSTANCE_SIGNATURE=test-instance \
    XDG_STATE_HOME="$window_test_dir" \
    OMARCHY_KIDS_HYPRCTL="$window_mock" \
    OMARCHY_KIDS_TEST_CLIENTS="$window_clients" \
    OMARCHY_KIDS_TEST_ACTIVE_WINDOW="$window_active" \
    OMARCHY_KIDS_TEST_ACTIVE_WORKSPACE="$window_workspace" \
    OMARCHY_KIDS_TEST_WINDOW_LOG="$window_log" \
    "$WINDOW_SESSION" enter
)
jq -e '.action == "enter" and .status == "active" and .hidden == 2
  and .expected == 2 and .failed == 0' <<< "$window_result" >/dev/null \
  && jq -e '.originalActiveWorkspace == "work"
    and .originalActiveMonitor == "DP-2"' \
    "$window_test_dir/omarchy-kids/windows.json" >/dev/null \
  || fail "window-session helper does not confirm every hidden window"

if window_result=$(
  HYPRLAND_INSTANCE_SIGNATURE=test-instance \
    XDG_STATE_HOME="$window_test_dir" \
    OMARCHY_KIDS_HYPRCTL="$window_mock" \
    OMARCHY_KIDS_TEST_CLIENTS="$window_clients" \
    OMARCHY_KIDS_TEST_ACTIVE_WINDOW="$window_active" \
    OMARCHY_KIDS_TEST_ACTIVE_WORKSPACE="$window_workspace" \
    OMARCHY_KIDS_TEST_WINDOW_LOG="$window_log" \
    OMARCHY_KIDS_TEST_FAIL_MOVE_ADDRESS=0xbbb \
    "$WINDOW_SESSION" exit
); then
  fail "window-session helper accepts a partial restore"
fi
jq -e '.action == "exit" and .status == "restore-failed"
  and .restored == 0 and .failed > 0' <<< "$window_result" >/dev/null \
  && jq -e '.active == true and .status == "restore-failed"' \
    "$window_test_dir/omarchy-kids/windows.json" >/dev/null \
  || fail "window-session helper does not retain a failed restore for retry"
[[ $(rg -c 'special:omarchy-kids-parent.*address:0xaaa' "$window_log") -ge 2 ]] \
  || fail "window-session helper does not compensate a partial restore"

if window_result=$(
  HYPRLAND_INSTANCE_SIGNATURE=test-instance \
    XDG_STATE_HOME="$window_test_dir" \
    OMARCHY_KIDS_HYPRCTL="$window_mock" \
    OMARCHY_KIDS_TEST_CLIENTS="$window_clients" \
    OMARCHY_KIDS_TEST_ACTIVE_WINDOW="$window_active" \
    OMARCHY_KIDS_TEST_ACTIVE_WORKSPACE="$window_workspace" \
    OMARCHY_KIDS_TEST_WINDOW_LOG="$window_log" \
    "$WINDOW_SESSION" enter
); then
  fail "window-session helper accepts an incomplete active snapshot"
fi
jq -e '.action == "enter" and .status == "incomplete-session"
  and .failed == 1' <<< "$window_result" >/dev/null \
  || fail "window-session helper does not reject an incomplete active snapshot"

window_result=$(
  HYPRLAND_INSTANCE_SIGNATURE=test-instance \
    XDG_STATE_HOME="$window_test_dir" \
    OMARCHY_KIDS_HYPRCTL="$window_mock" \
    OMARCHY_KIDS_TEST_CLIENTS="$window_clients" \
    OMARCHY_KIDS_TEST_ACTIVE_WINDOW="$window_active" \
    OMARCHY_KIDS_TEST_ACTIVE_WORKSPACE="$window_workspace" \
    OMARCHY_KIDS_TEST_WINDOW_LOG="$window_log" \
    "$WINDOW_SESSION" exit
)
jq -e '.action == "exit" and .status == "restored" and .restored == 2
  and .missing == 0 and .failed == 0' <<< "$window_result" >/dev/null \
  && jq -e '.active == false and .status == "restored"' \
    "$window_test_dir/omarchy-kids/windows.json" >/dev/null \
  || fail "window-session helper cannot complete a retried restore"

window_focus_dir=$(mktemp -d)
focus_log=$window_focus_dir/hyprctl.log
HYPRLAND_INSTANCE_SIGNATURE=test-instance \
  XDG_STATE_HOME="$window_focus_dir" \
  OMARCHY_KIDS_HYPRCTL="$window_mock" \
  OMARCHY_KIDS_TEST_CLIENTS="$window_clients" \
  OMARCHY_KIDS_TEST_ACTIVE_WINDOW="$window_active" \
  OMARCHY_KIDS_TEST_ACTIVE_WORKSPACE="$window_workspace" \
  OMARCHY_KIDS_TEST_WINDOW_LOG="$focus_log" \
  "$WINDOW_SESSION" enter >/dev/null
if window_result=$(
  HYPRLAND_INSTANCE_SIGNATURE=test-instance \
    XDG_STATE_HOME="$window_focus_dir" \
    OMARCHY_KIDS_HYPRCTL="$window_mock" \
    OMARCHY_KIDS_TEST_CLIENTS="$window_clients" \
    OMARCHY_KIDS_TEST_ACTIVE_WINDOW="$window_active" \
    OMARCHY_KIDS_TEST_ACTIVE_WORKSPACE="$window_workspace" \
    OMARCHY_KIDS_TEST_WINDOW_LOG="$focus_log" \
    OMARCHY_KIDS_TEST_FAIL_WINDOW_FOCUS=true \
    "$WINDOW_SESSION" exit
); then
  fail "window-session helper accepts an original-window focus failure"
fi
jq -e '.status == "restore-failed" and .failed > 0' \
  <<< "$window_result" >/dev/null \
  && tail -n 1 "$focus_log" | rg -Fq 'workspace = "name:omarchy-kids"' \
  || fail "window-session helper does not return to Kids workspace after compensation"
HYPRLAND_INSTANCE_SIGNATURE=test-instance \
  XDG_STATE_HOME="$window_focus_dir" \
  OMARCHY_KIDS_HYPRCTL="$window_mock" \
  OMARCHY_KIDS_TEST_CLIENTS="$window_clients" \
  OMARCHY_KIDS_TEST_ACTIVE_WINDOW="$window_active" \
  OMARCHY_KIDS_TEST_ACTIVE_WORKSPACE="$window_workspace" \
  OMARCHY_KIDS_TEST_WINDOW_LOG="$focus_log" \
  "$WINDOW_SESSION" exit >/dev/null
rm -rf -- "$window_focus_dir"

window_missing_dir=$(mktemp -d)
missing_marker=$window_missing_dir/client-query.marker
HYPRLAND_INSTANCE_SIGNATURE=test-instance \
  XDG_STATE_HOME="$window_missing_dir" \
  OMARCHY_KIDS_HYPRCTL="$window_mock" \
  OMARCHY_KIDS_TEST_CLIENTS="$window_clients" \
  OMARCHY_KIDS_TEST_ACTIVE_WINDOW="$window_active" \
  OMARCHY_KIDS_TEST_ACTIVE_WORKSPACE="$window_workspace" \
  OMARCHY_KIDS_TEST_WINDOW_LOG="$window_log" \
  "$WINDOW_SESSION" enter >/dev/null
window_result=$(
  HYPRLAND_INSTANCE_SIGNATURE=test-instance \
    XDG_STATE_HOME="$window_missing_dir" \
    OMARCHY_KIDS_HYPRCTL="$window_mock" \
    OMARCHY_KIDS_TEST_CLIENTS="$window_clients_missing" \
    OMARCHY_KIDS_TEST_POST_CLIENTS="$window_clients_missing_restored" \
    OMARCHY_KIDS_TEST_CLIENTS_MARKER="$missing_marker" \
    OMARCHY_KIDS_TEST_ACTIVE_WINDOW="$window_active" \
    OMARCHY_KIDS_TEST_ACTIVE_WORKSPACE="$window_workspace" \
    OMARCHY_KIDS_TEST_WINDOW_LOG="$window_log" \
    "$WINDOW_SESSION" exit
)
jq -e '.status == "restored" and .expected == 2 and .live == 1
  and .restored == 1 and .missing == 1 and .failed == 0
  and .kidsRemaining == 0 and .workspaceRemoved == true' \
  <<< "$window_result" >/dev/null \
  || fail "window-session helper does not distinguish closed windows from restore failures"

window_multi_dir=$(mktemp -d)
multi_log=$window_multi_dir/hyprctl.log
multi_marker=$window_multi_dir/client-query.marker
HYPRLAND_INSTANCE_SIGNATURE=test-instance \
  XDG_STATE_HOME="$window_multi_dir" \
  OMARCHY_KIDS_HYPRCTL="$window_mock" \
  OMARCHY_KIDS_TEST_CLIENTS="$window_clients" \
  OMARCHY_KIDS_TEST_ACTIVE_WINDOW="$window_active" \
  OMARCHY_KIDS_TEST_ACTIVE_WORKSPACE="$window_workspace" \
  OMARCHY_KIDS_TEST_WINDOW_LOG="$multi_log" \
  "$WINDOW_SESSION" enter >/dev/null
window_result=$(
  HYPRLAND_INSTANCE_SIGNATURE=test-instance \
    XDG_STATE_HOME="$window_multi_dir" \
    OMARCHY_KIDS_HYPRCTL="$window_mock" \
    OMARCHY_KIDS_TEST_CLIENTS="$window_clients_kids" \
    OMARCHY_KIDS_TEST_POST_CLIENTS="$window_clients_restored" \
    OMARCHY_KIDS_TEST_CLIENTS_MARKER="$multi_marker" \
    OMARCHY_KIDS_TEST_ACTIVE_WINDOW="$window_active" \
    OMARCHY_KIDS_TEST_ACTIVE_WORKSPACE="$window_workspace" \
    OMARCHY_KIDS_TEST_WINDOW_LOG="$multi_log" \
    "$WINDOW_SESSION" exit
)
jq -e '.status == "restored" and .expected == 2 and .restored == 2
  and .evacuated == 2 and .kidsRemaining == 0
  and .workspaceRemoved == true and .failed == 0' \
  <<< "$window_result" >/dev/null \
  && jq -e '.active == false and .status == "restored"
    and .originalActiveMonitor == "DP-2" and .workspaceRemoved == true' \
    "$window_multi_dir/omarchy-kids/windows.json" >/dev/null \
  || fail "window-session helper does not evacuate Kids-launched windows"
rg -q 'workspace = "name:work".*address:0xccc' "$multi_log" \
  && rg -q 'workspace = "name:work".*address:0xddd' "$multi_log" \
  && ! rg -Fq 'address:0xeee' "$multi_log" \
  || fail "window-session helper evacuates the wrong post-entry windows"
monitor_focus_line=$(rg -nF 'hl.dsp.focus({ monitor = "DP-2" })' "$multi_log" \
  | tail -1 | cut -d: -f1)
workspace_focus_line=$(rg -nF 'hl.dsp.focus({ workspace = "name:work" })' "$multi_log" \
  | tail -1 | cut -d: -f1)
[[ -n $monitor_focus_line && -n $workspace_focus_line \
    && $monitor_focus_line -lt $workspace_focus_line ]] \
  || fail "window-session helper does not restore the original monitor before its workspace"

window_residual_dir=$(mktemp -d)
residual_log=$window_residual_dir/hyprctl.log
residual_marker=$window_residual_dir/client-query.marker
HYPRLAND_INSTANCE_SIGNATURE=test-instance \
  XDG_STATE_HOME="$window_residual_dir" \
  OMARCHY_KIDS_HYPRCTL="$window_mock" \
  OMARCHY_KIDS_TEST_CLIENTS="$window_clients" \
  OMARCHY_KIDS_TEST_ACTIVE_WINDOW="$window_active" \
  OMARCHY_KIDS_TEST_ACTIVE_WORKSPACE="$window_workspace" \
  OMARCHY_KIDS_TEST_WINDOW_LOG="$residual_log" \
  "$WINDOW_SESSION" enter >/dev/null
if window_result=$(
  HYPRLAND_INSTANCE_SIGNATURE=test-instance \
    XDG_STATE_HOME="$window_residual_dir" \
    OMARCHY_KIDS_HYPRCTL="$window_mock" \
    OMARCHY_KIDS_TEST_CLIENTS="$window_clients_kids" \
    OMARCHY_KIDS_TEST_POST_CLIENTS="$window_clients_restored" \
    OMARCHY_KIDS_TEST_CLIENTS_MARKER="$residual_marker" \
    OMARCHY_KIDS_TEST_ACTIVE_WINDOW="$window_active" \
    OMARCHY_KIDS_TEST_ACTIVE_WORKSPACE="$window_workspace" \
    OMARCHY_KIDS_TEST_WORKSPACES="$window_workspaces_kids" \
    OMARCHY_KIDS_TEST_WINDOW_LOG="$residual_log" \
    "$WINDOW_SESSION" exit
); then
  fail "window-session helper accepts a residual Kids workspace"
fi
jq -e '.status == "restore-failed" and .workspaceRemoved == false
  and .evacuated == 2 and .failed > 0' <<< "$window_result" >/dev/null \
  && jq -e '.active == true and .status == "restore-failed"' \
    "$window_residual_dir/omarchy-kids/windows.json" >/dev/null \
  && rg -q 'workspace = "name:omarchy-kids".*address:0xccc' "$residual_log" \
  && rg -q 'workspace = "name:omarchy-kids".*address:0xddd' "$residual_log" \
  || fail "window-session helper does not compensate a failed disappearance check"

window_misdirected_dir=$(mktemp -d)
misdirected_log=$window_misdirected_dir/hyprctl.log
misdirected_marker=$window_misdirected_dir/client-query.marker
HYPRLAND_INSTANCE_SIGNATURE=test-instance \
  XDG_STATE_HOME="$window_misdirected_dir" \
  OMARCHY_KIDS_HYPRCTL="$window_mock" \
  OMARCHY_KIDS_TEST_CLIENTS="$window_clients" \
  OMARCHY_KIDS_TEST_ACTIVE_WINDOW="$window_active" \
  OMARCHY_KIDS_TEST_ACTIVE_WORKSPACE="$window_workspace" \
  OMARCHY_KIDS_TEST_WINDOW_LOG="$misdirected_log" \
  "$WINDOW_SESSION" enter >/dev/null
if window_result=$(
  HYPRLAND_INSTANCE_SIGNATURE=test-instance \
    XDG_STATE_HOME="$window_misdirected_dir" \
    OMARCHY_KIDS_HYPRCTL="$window_mock" \
    OMARCHY_KIDS_TEST_CLIENTS="$window_clients_kids" \
    OMARCHY_KIDS_TEST_POST_CLIENTS="$window_clients_misdirected" \
    OMARCHY_KIDS_TEST_CLIENTS_MARKER="$misdirected_marker" \
    OMARCHY_KIDS_TEST_ACTIVE_WINDOW="$window_active" \
    OMARCHY_KIDS_TEST_ACTIVE_WORKSPACE="$window_workspace" \
    OMARCHY_KIDS_TEST_WINDOW_LOG="$misdirected_log" \
    "$WINDOW_SESSION" exit
); then
  fail "window-session helper trusts successful but misdirected dispatches"
fi
jq -e '.status == "restore-failed" and .kidsRemaining == 0
  and .workspaceRemoved == false and .failed > 0' <<< "$window_result" >/dev/null \
  && jq -e '.active == true and .status == "restore-failed"' \
    "$window_misdirected_dir/omarchy-kids/windows.json" >/dev/null \
  || fail "window-session helper does not verify final workspace and pin state"

window_legacy_dir=$(mktemp -d)
legacy_log=$window_legacy_dir/hyprctl.log
HYPRLAND_INSTANCE_SIGNATURE=test-instance \
  XDG_STATE_HOME="$window_legacy_dir" \
  OMARCHY_KIDS_HYPRCTL="$window_mock" \
  OMARCHY_KIDS_TEST_CLIENTS="$window_clients" \
  OMARCHY_KIDS_TEST_ACTIVE_WINDOW="$window_active" \
  OMARCHY_KIDS_TEST_ACTIVE_WORKSPACE="$window_workspace" \
  OMARCHY_KIDS_TEST_WINDOW_LOG="$legacy_log" \
  "$WINDOW_SESSION" enter >/dev/null
legacy_state=$window_legacy_dir/omarchy-kids/windows.json
legacy_state_tmp=$window_legacy_dir/omarchy-kids/windows.legacy
jq 'del(.originalActiveMonitor)' "$legacy_state" > "$legacy_state_tmp"
mv -- "$legacy_state_tmp" "$legacy_state"
window_result=$(
  HYPRLAND_INSTANCE_SIGNATURE=test-instance \
    XDG_STATE_HOME="$window_legacy_dir" \
    OMARCHY_KIDS_HYPRCTL="$window_mock" \
    OMARCHY_KIDS_TEST_CLIENTS="$window_clients" \
    OMARCHY_KIDS_TEST_ACTIVE_WINDOW="$window_active" \
    OMARCHY_KIDS_TEST_ACTIVE_WORKSPACE="$window_workspace" \
    OMARCHY_KIDS_TEST_WINDOW_LOG="$legacy_log" \
    "$WINDOW_SESSION" exit
)
jq -e '.status == "restored" and .workspaceRemoved == true' \
  <<< "$window_result" >/dev/null \
  && ! rg -Fq 'hl.dsp.focus({ monitor = ' "$legacy_log" \
  || fail "window-session helper breaks a legacy version-1 snapshot"

window_hotplug_dir=$(mktemp -d)
hotplug_log=$window_hotplug_dir/hyprctl.log
HYPRLAND_INSTANCE_SIGNATURE=test-instance \
  XDG_STATE_HOME="$window_hotplug_dir" \
  OMARCHY_KIDS_HYPRCTL="$window_mock" \
  OMARCHY_KIDS_TEST_CLIENTS="$window_clients" \
  OMARCHY_KIDS_TEST_ACTIVE_WINDOW="$window_active" \
  OMARCHY_KIDS_TEST_ACTIVE_WORKSPACE="$window_workspace" \
  OMARCHY_KIDS_TEST_WINDOW_LOG="$hotplug_log" \
  "$WINDOW_SESSION" enter >/dev/null
window_result=$(
  HYPRLAND_INSTANCE_SIGNATURE=test-instance \
    XDG_STATE_HOME="$window_hotplug_dir" \
    OMARCHY_KIDS_HYPRCTL="$window_mock" \
    OMARCHY_KIDS_TEST_CLIENTS="$window_clients" \
    OMARCHY_KIDS_TEST_ACTIVE_WINDOW="$window_active" \
    OMARCHY_KIDS_TEST_ACTIVE_WORKSPACE="$window_workspace_fallback" \
    OMARCHY_KIDS_TEST_MONITORS="$window_monitors_hotplug" \
    OMARCHY_KIDS_TEST_WINDOW_LOG="$hotplug_log" \
    "$WINDOW_SESSION" exit
)
jq -e '.status == "restored" and .workspaceRemoved == true' \
  <<< "$window_result" >/dev/null \
  && ! rg -Fq 'hl.dsp.focus({ monitor = "DP-2" })' "$hotplug_log" \
  || fail "window-session helper cannot fall back after the original monitor disappears"

window_stale_dir=$(mktemp -d)
stale_log=$window_stale_dir/hyprctl.log
HYPRLAND_INSTANCE_SIGNATURE=test-instance \
  XDG_STATE_HOME="$window_stale_dir" \
  OMARCHY_KIDS_HYPRCTL="$window_mock" \
  OMARCHY_KIDS_TEST_CLIENTS="$window_clients" \
  OMARCHY_KIDS_TEST_ACTIVE_WINDOW="$window_active" \
  OMARCHY_KIDS_TEST_ACTIVE_WORKSPACE="$window_workspace" \
  OMARCHY_KIDS_TEST_WINDOW_LOG="$stale_log" \
  "$WINDOW_SESSION" enter >/dev/null
if window_result=$(
  HYPRLAND_INSTANCE_SIGNATURE=restarted-instance \
    XDG_STATE_HOME="$window_stale_dir" \
    OMARCHY_KIDS_HYPRCTL="$window_mock" \
    OMARCHY_KIDS_TEST_CLIENTS="$window_clients_kids" \
    OMARCHY_KIDS_TEST_WORKSPACES="$window_workspaces_kids" \
    OMARCHY_KIDS_TEST_WINDOW_LOG="$stale_log" \
    "$WINDOW_SESSION" exit
); then
  fail "window-session helper accepts an unverified stale session"
fi
jq -e '.status == "restore-failed" and .workspaceRemoved == false
  and .kidsRemaining == 3' <<< "$window_result" >/dev/null \
  && jq -e '.active == true and .status == "restore-failed"' \
    "$window_stale_dir/omarchy-kids/windows.json" >/dev/null \
  || fail "window-session helper does not retain a stale session with Kids state"
window_result=$(
  HYPRLAND_INSTANCE_SIGNATURE=restarted-instance \
    XDG_STATE_HOME="$window_stale_dir" \
    OMARCHY_KIDS_HYPRCTL="$window_mock" \
    OMARCHY_KIDS_TEST_CLIENTS="$window_clients" \
    OMARCHY_KIDS_TEST_WORKSPACES="$window_workspaces" \
    OMARCHY_KIDS_TEST_WINDOW_LOG="$stale_log" \
    "$WINDOW_SESSION" exit
)
jq -e '.status == "stale-session" and .workspaceRemoved == true
  and .kidsRemaining == 0 and .failed == 0' <<< "$window_result" >/dev/null \
  && jq -e '.active == false and .status == "stale-session"' \
    "$window_stale_dir/omarchy-kids/windows.json" >/dev/null \
  || fail "window-session helper cannot verify a clean restarted compositor"

window_cleanup_dir=$(mktemp -d)
cleanup_log=$window_cleanup_dir/hyprctl.log
cleanup_marker=$window_cleanup_dir/client-query.marker
HYPRLAND_INSTANCE_SIGNATURE=test-instance \
  XDG_STATE_HOME="$window_cleanup_dir" \
  OMARCHY_KIDS_HYPRCTL="$window_mock" \
  OMARCHY_KIDS_TEST_CLIENTS="$window_clients" \
  OMARCHY_KIDS_TEST_ACTIVE_WINDOW="$window_active" \
  OMARCHY_KIDS_TEST_ACTIVE_WORKSPACE="$window_workspace" \
  OMARCHY_KIDS_TEST_WINDOW_LOG="$cleanup_log" \
  "$WINDOW_SESSION" enter >/dev/null
window_result=$(
  HYPRLAND_INSTANCE_SIGNATURE=test-instance \
    XDG_STATE_HOME="$window_cleanup_dir" \
    XDG_RUNTIME_DIR="$window_cleanup_dir/runtime" \
    OMARCHY_KIDS_CLEANUP_SETTLE_SECONDS=0 \
    OMARCHY_KIDS_HYPRCTL="$window_mock" \
    OMARCHY_KIDS_TEST_CLIENTS="$window_clients_kids" \
    OMARCHY_KIDS_TEST_POST_CLIENTS="$window_clients_restored" \
    OMARCHY_KIDS_TEST_CLIENTS_MARKER="$cleanup_marker" \
    OMARCHY_KIDS_TEST_ACTIVE_WINDOW="$window_active" \
    OMARCHY_KIDS_TEST_ACTIVE_WORKSPACE="$window_workspace" \
    OMARCHY_KIDS_TEST_WINDOW_LOG="$cleanup_log" \
    "$LIFECYCLE_CLEANUP" "$WINDOW_SESSION" "$SHORTCUT_POLICY"
)
jq -e '.action == "exit" and .applied == false' <<< "$window_result" >/dev/null \
  && jq -e '.active == false and .status == "restored"
    and .evacuated == 2 and .workspaceRemoved == true' \
    "$window_cleanup_dir/omarchy-kids/windows.json" >/dev/null \
  || fail "detached lifecycle cleanup does not order verified exit before shortcut release"

window_dirty_inactive_dir=$(mktemp -d)
dirty_runtime=$window_dirty_inactive_dir/runtime
mkdir -p "$dirty_runtime/omarchy-kids"
printf 'version=1\n' > "$dirty_runtime/omarchy-kids/shortcut-policy.active"
if HYPRLAND_INSTANCE_SIGNATURE=test-instance \
    XDG_STATE_HOME="$window_dirty_inactive_dir/state" \
    XDG_RUNTIME_DIR="$dirty_runtime" \
    OMARCHY_KIDS_CLEANUP_SETTLE_SECONDS=0 \
    OMARCHY_KIDS_CLEANUP_RETRY_SECONDS=0 \
    OMARCHY_KIDS_HYPRCTL="$window_mock" \
    OMARCHY_KIDS_TEST_CLIENTS="$window_clients_kids" \
    OMARCHY_KIDS_TEST_WORKSPACES="$window_workspaces_kids" \
    OMARCHY_KIDS_TEST_WINDOW_LOG="$window_dirty_inactive_dir/hyprctl.log" \
    "$LIFECYCLE_CLEANUP" "$WINDOW_SESSION" "$SHORTCUT_POLICY"; then
  fail "detached lifecycle cleanup accepts unverified inactive state"
fi
[[ -f $dirty_runtime/omarchy-kids/shortcut-policy.active \
    && ! -e $dirty_runtime/omarchy-kids/shortcut-policy.lock ]] \
  || fail "detached lifecycle cleanup releases shortcuts after dirty inactive exit"

rg -q 'readonly property bool kidsModeActive:' "$PLUGIN_ROOT/Menu.qml" \
  && rg -q 'allowlistService\.modePhase === "active"' "$PLUGIN_ROOT/Menu.qml" \
  && rg -q 'result\.workspaceRemoved === true' "$PLUGIN_ROOT/Service.qml" \
  && rg -q 'Number\(result\.kidsRemaining \|\| 0\) === 0' "$PLUGIN_ROOT/Service.qml" \
  && rg -q 'windowLaunchGuardPending\(\)' "$PLUGIN_ROOT/Service.qml" \
  || fail "the menu lifecycle does not gate launches and enforce cleanup verification"
rm -rf -- "$window_dirty_inactive_dir" "$window_cleanup_dir" "$window_stale_dir" "$window_hotplug_dir" \
  "$window_legacy_dir" "$window_misdirected_dir" \
  "$window_residual_dir" "$window_multi_dir" "$window_missing_dir" "$window_test_dir"

shortcut_test_dir=$(mktemp -d)
shortcut_log=$shortcut_test_dir/hyprctl.log
shortcut_fixture=$PLUGIN_ROOT/test/fixtures/stock-bindings.json
shortcut_mock=$PLUGIN_ROOT/test/hyprctl-mock
keybindings_fixture=$PLUGIN_ROOT/test/fixtures/stock-bindings.txt
keybindings_mock=$PLUGIN_ROOT/test/keybindings-mock
universal_fixture=$PLUGIN_ROOT/test/fixtures/universal-binding.json
kids_submap_fixture=$PLUGIN_ROOT/test/fixtures/kids-submap-binding.json

shortcut_result=$(
  XDG_RUNTIME_DIR="$shortcut_test_dir/runtime" \
    OMARCHY_KIDS_HYPRCTL="$shortcut_mock" \
    OMARCHY_KIDS_KEYBINDINGS="$keybindings_mock" \
    OMARCHY_KIDS_TEST_BINDS="$shortcut_fixture" \
    OMARCHY_KIDS_TEST_RENDERED_BINDS="$keybindings_fixture" \
    OMARCHY_KIDS_TEST_LOG="$shortcut_log" \
    "$SHORTCUT_POLICY" enter true true true
)
jq -e '.action == "enter" and .applied == true and .changed > 0' \
  <<< "$shortcut_result" >/dev/null \
  || fail "shortcut policy does not report a successful transient layer"
rg -Fq 'hl.define_submap("omarchy-kids", function()' "$shortcut_log" \
  && rg -Fq 'Kids Mode: Menu' "$shortcut_log" \
  && rg -Fq 'Kids Mode: Browser' "$shortcut_log" \
  && rg -Fq 'Kids Mode: Omawrite' "$shortcut_log" \
  && rg -Fq 'Kids Mode: Calculator' "$shortcut_log" \
  && rg -Fq 'hl.bind("SUPER + W", hl.dsp.window.close()' "$shortcut_log" \
  && rg -Fq 'hl.bind("XF86AudioRaiseVolume"' "$shortcut_log" \
  && rg -Fq 'hl.bind("SUPER + CTRL + L"' "$shortcut_log" \
  && rg -Fq 'hl.bind("switch:on:Lid Switch"' "$shortcut_log" \
  && rg -Fq 'hl.dispatch(hl.dsp.submap("omarchy-kids"))' "$shortcut_log" \
  && rg -Fq 'hl.get_current_submap() == "omarchy-kids"' "$shortcut_log" \
  && ! rg -Fq 'hl.unbind(' "$shortcut_log" \
  || fail "shortcut policy does not install and verify a default-deny submap"

: > "$shortcut_log"
shortcut_result=$(
  XDG_RUNTIME_DIR="$shortcut_test_dir/runtime" \
    OMARCHY_KIDS_HYPRCTL="$shortcut_mock" \
    OMARCHY_KIDS_KEYBINDINGS="$keybindings_mock" \
    OMARCHY_KIDS_TEST_BINDS="$shortcut_fixture" \
    OMARCHY_KIDS_TEST_RENDERED_BINDS="$keybindings_fixture" \
    OMARCHY_KIDS_TEST_LOG="$shortcut_log" \
    "$SHORTCUT_POLICY" enter false false false
)
jq -e '.action == "enter" and .applied == true' <<< "$shortcut_result" >/dev/null \
  || fail "shortcut policy cannot rebuild itself after a shell reload"
[[ $(rg -c '^reload$' "$shortcut_log") == 1 ]] \
  || fail "shortcut policy does not restore configuration before rebuilding its layer"
! rg -Fq 'Kids Mode: Browser' "$shortcut_log" \
  && ! rg -Fq 'Kids Mode: Omawrite' "$shortcut_log" \
  && ! rg -Fq 'Kids Mode: Calculator' "$shortcut_log" \
  || fail "shortcut policy does not follow the current default-app selection"

: > "$shortcut_log"
shortcut_result=$(
  XDG_RUNTIME_DIR="$shortcut_test_dir/runtime" \
    OMARCHY_KIDS_HYPRCTL="$shortcut_mock" \
    OMARCHY_KIDS_TEST_BINDS="$shortcut_fixture" \
    OMARCHY_KIDS_TEST_LOG="$shortcut_log" \
    "$SHORTCUT_POLICY" exit
)
jq -e '.action == "exit" and .applied == false and .restored == true' \
  <<< "$shortcut_result" >/dev/null \
  && [[ $(rg -c '^reload$' "$shortcut_log") == 1 ]] \
  && [[ ! -e $shortcut_test_dir/runtime/omarchy-kids/shortcut-policy.active ]] \
  || fail "shortcut policy does not restore Hyprland state on exit"

if shortcut_result=$(
  XDG_RUNTIME_DIR="$shortcut_test_dir/universal-runtime" \
    OMARCHY_KIDS_HYPRCTL="$shortcut_mock" \
    OMARCHY_KIDS_TEST_BINDS="$universal_fixture" \
    OMARCHY_KIDS_TEST_LOG="$shortcut_log" \
    "$SHORTCUT_POLICY" enter true true true
); then
  fail "shortcut policy accepts a universal binding that bypasses submaps"
fi
jq -e '.action == "enter" and .applied == false
  and (.error | contains("universal Hyprland binding"))' \
  <<< "$shortcut_result" >/dev/null \
  || fail "shortcut policy does not explain a universal-binding refusal"

if shortcut_result=$(
  XDG_RUNTIME_DIR="$shortcut_test_dir/collision-runtime" \
    OMARCHY_KIDS_HYPRCTL="$shortcut_mock" \
    OMARCHY_KIDS_TEST_BINDS="$kids_submap_fixture" \
    OMARCHY_KIDS_TEST_LOG="$shortcut_log" \
    "$SHORTCUT_POLICY" enter true true true
); then
  fail "shortcut policy accepts a pre-existing binding in its target submap"
fi
jq -e '.action == "enter" and .applied == false
  and (.error | contains("submap name is already in use"))' \
  <<< "$shortcut_result" >/dev/null \
  || fail "shortcut policy does not explain a target-submap collision"
rm -rf -- "$shortcut_test_dir"

rg -q 'sourceAppLibrary\.sortedEntries' "$PLUGIN_ROOT/Menu.qml" \
  && rg -q 'Allowlist\.filterRows' "$PLUGIN_ROOT/Menu.qml" \
  && rg -q 'sourceAppLibrary\.launch' "$PLUGIN_ROOT/Menu.qml" \
  || fail "menu is not filtering and launching through Omarchy DesktopEntries"

rg -q 'KidsBrowser\.isBrowser' "$PLUGIN_ROOT/Menu.qml" \
  && rg -q 'KidsBrowser\.webAppUrl' "$PLUGIN_ROOT/Menu.qml" \
  && rg -q 'function entryFor' "$PLUGIN_ROOT/Menu.qml" \
  && rg -q 'entry\.execString' "$PLUGIN_ROOT/Menu.qml" \
  && rg -Fq 'Quickshell.execDetached(KidsBrowser.launchCommand' "$PLUGIN_ROOT/Menu.qml" \
  && rg -q -- '--user-data-dir=' "$PLUGIN_ROOT/KidsBrowser.js" \
  && rg -q -- '--no-first-run' "$PLUGIN_ROOT/KidsBrowser.js" \
  && rg -q -- '--disable-sync' "$PLUGIN_ROOT/KidsBrowser.js" \
  && rg -q -- '--new-window' "$PLUGIN_ROOT/KidsBrowser.js" \
  && rg -q -- '--app=' "$PLUGIN_ROOT/KidsBrowser.js" \
  || fail "Kids Mode browser and web-app launches are not isolated in the persistent local profile"

rg -q 'special:omarchy-kids-parent' "$WINDOW_SESSION" \
  && rg -q 'hl\.dsp\.window\.move' "$WINDOW_SESSION" \
  && rg -q 'hl\.dsp\.window\.pin' "$WINDOW_SESSION" \
  && rg -q 'hl\.dsp\.focus' "$WINDOW_SESSION" \
  && rg -q 'originalActiveWorkspace' "$WINDOW_SESSION" \
  && rg -q 'Quickshell\.execDetached\(\[root\.windowSessionTool, "exit"\]\)' "$PLUGIN_ROOT/Service.qml" \
  && rg -q 'function guardAppLaunch' "$PLUGIN_ROOT/Service.qml" "$PLUGIN_ROOT/Menu.qml" \
  || fail "Kids Mode does not reversibly hide and guard pre-existing windows"

rg -q 'item\.userMenuPath = root\.pluginRoot \+ "/empty-menu\.jsonc"' "$PLUGIN_ROOT/Menu.qml" \
  || fail "normal menu extensions can leak unfiltered actions into kids mode"

rg -q 'function remove\(' "$PLUGIN_ROOT/Menu.qml" \
  && ! rg -q 'sourceAppLibrary\.remove|omarchy-(install|pkg|remove)' "$PLUGIN_ROOT/Menu.qml" "$PLUGIN_ROOT/Service.qml" "$MENU" \
  || fail "plugin can install, uninstall, or remove an application"

rg -q 'allowed-apps\.json' "$PLUGIN_ROOT/Service.qml" \
  && rg -q 'toggleAllowed' "$PLUGIN_ROOT/Service.qml" "$PLUGIN_ROOT/Panel.qml" \
  && rg -q 'readonly property bool allowlistEditable: root\.modeStateLoaded && !root\.kidsModeEnabled' "$PLUGIN_ROOT/Service.qml" \
  && rg -q 'persist && !root\.allowlistEditable' "$PLUGIN_ROOT/Service.qml" \
  && rg -q '!root\.allowlistEditable' "$PLUGIN_ROOT/Service.qml" "$PLUGIN_ROOT/Panel.qml" \
  && rg -q 'enabled: root\.allowlistEditable' "$PLUGIN_ROOT/Panel.qml" \
  && rg -q 'selectionFilter === "selected"' "$PLUGIN_ROOT/Panel.qml" \
  && rg -q 'selectionFilter === "not-selected"' "$PLUGIN_ROOT/Panel.qml" \
  && rg -q 'filterLabel: "NOT SELECTED"' "$PLUGIN_ROOT/Panel.qml" \
  && rg -q 'Qt\.Key_3' "$PLUGIN_ROOT/Panel.qml" \
  && rg -q 'managerWidgetId: pluginId \+ "\.manager"' "$PLUGIN_ROOT/Service.qml" \
  && rg -q 'ShellIntegration\.activate' "$PLUGIN_ROOT/Service.qml" \
  && rg -q 'ManagerWidget\.qml' "$PLUGIN_ROOT/Service.qml" \
  || fail "right-side app manager is not mode-gated or wired to the persisted allowlist and quick filters"

if rg -Fq 'Normal Omarchy menu active • notifications restored' "$PLUGIN_ROOT/Panel.qml" \
  || rg -Fq 'App selections are saved automatically across reboots.' "$PLUGIN_ROOT/Panel.qml" \
  || rg -Fq 'apps available • notifications muted' "$PLUGIN_ROOT/Panel.qml" \
  || rg -Fq 'Exit Kids Mode to change available apps.' "$PLUGIN_ROOT/Panel.qml"; then
