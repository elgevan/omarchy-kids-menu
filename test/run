  && rg -Fq 'height: Style.space(360)' "$PLUGIN_ROOT/Panel.qml" \
  || fail "manager compact sizing has regressed"

rg -q 'setStockMenuDisabled\(config, kidsModeEnabled === true\)' "$PLUGIN_ROOT/ShellIntegration.js" \
  && rg -q 'ShellIntegration\.deactivate' "$PLUGIN_ROOT/Service.qml" \
  && rg -q 'root\.shell\.hide\(ShellIntegration\.STOCK_MENU_ID\)' "$PLUGIN_ROOT/Service.qml" \
  && ! jq -e '.omarchy.clonedFrom? != null' "$MANIFEST" >/dev/null \
  || fail "standalone shell integration does not block and restore the stock menu cleanly"

rg -q 'serviceFor\("omarchy\.notifications"\)' "$PLUGIN_ROOT/Service.qml" \
  && rg -q 'root\.kidsModeEnabled' "$PLUGIN_ROOT/Service.qml" \
  && rg -q 'setDoNotDisturb\(true\)' "$PLUGIN_ROOT/Service.qml" \
  && rg -q 'notifications\.setDoNotDisturb\(root\.notificationRestoreDnd\)' "$PLUGIN_ROOT/Service.qml" \
  && rg -q 'NotificationState\.stateText\(false, false\)' "$PLUGIN_ROOT/Service.qml" \
