    OMARCHY_KIDS_TEST_ACTIVE_WORKSPACE="$window_workspace" \
    OMARCHY_KIDS_TEST_WINDOW_LOG="$cleanup_log" \
    "$LIFECYCLE_CLEANUP" "$WINDOW_SESSION" "$SHORTCUT_POLICY"
)
jq -e '.action == "exit" and .applied == false' <<< "$window_result" >/dev/null \
  && jq -e '.active == false and .status == "restored"
    and .evacuated == 3 and .workspaceRemoved == true' \
    "$window_cleanup_dir/omarchy-kids/windows.json" >/dev/null \
  || fail "detached lifecycle cleanup does not order verified exit before shortcut release"

window_cleanup_refusal_dir=$(mktemp -d)
cleanup_refusal_log=$window_cleanup_refusal_dir/hyprctl.log
cleanup_refusal_marker=$window_cleanup_refusal_dir/client-query.marker
cleanup_refusal_runtime=$window_cleanup_refusal_dir/runtime
cleanup_refusal_error=$window_cleanup_refusal_dir/cleanup.err
mkdir -p "$cleanup_refusal_runtime/omarchy-kids"
printf 'version=1\n' > "$cleanup_refusal_runtime/omarchy-kids/shortcut-policy.active"
HYPRLAND_INSTANCE_SIGNATURE=test-instance \
  XDG_STATE_HOME="$window_cleanup_refusal_dir" \
  OMARCHY_KIDS_HYPRCTL="$window_mock" \
  OMARCHY_KIDS_TEST_CLIENTS="$window_clients" \
  OMARCHY_KIDS_TEST_ACTIVE_WINDOW="$window_active" \
  OMARCHY_KIDS_TEST_ACTIVE_WORKSPACE="$window_workspace" \
  OMARCHY_KIDS_TEST_WINDOW_LOG="$cleanup_refusal_log" \
  "$WINDOW_SESSION" enter >/dev/null
if HYPRLAND_INSTANCE_SIGNATURE=test-instance \
    XDG_STATE_HOME="$window_cleanup_refusal_dir" \
    XDG_RUNTIME_DIR="$cleanup_refusal_runtime" \
    OMARCHY_KIDS_CLEANUP_SETTLE_SECONDS=0 \
    OMARCHY_KIDS_CLEANUP_RETRY_SECONDS=0 \
    OMARCHY_KIDS_CLEANUP_MAX_ATTEMPTS=3 \
    OMARCHY_KIDS_HYPRCTL="$window_mock" \
    OMARCHY_KIDS_TEST_CLIENTS="$window_clients_kids" \
    OMARCHY_KIDS_TEST_POST_CLIENTS="$window_clients_close_refused" \
    OMARCHY_KIDS_TEST_EXPECT_CLOSE_COUNT=3 \
    OMARCHY_KIDS_TEST_CLIENTS_MARKER="$cleanup_refusal_marker" \
    OMARCHY_KIDS_TEST_ACTIVE_WINDOW="$window_active" \
    OMARCHY_KIDS_TEST_ACTIVE_WORKSPACE="$window_workspace" \
    OMARCHY_KIDS_TEST_WINDOW_LOG="$cleanup_refusal_log" \
    OMARCHY_KIDS_CLOSE_ATTEMPTS=1 \
    OMARCHY_KIDS_CLOSE_INTERVAL=0 \
    "$LIFECYCLE_CLEANUP" "$WINDOW_SESSION" "$SHORTCUT_POLICY" \
    2>"$cleanup_refusal_error"; then
  fail "detached lifecycle cleanup accepts a refused Kids-app close"
fi
[[ ! -e $cleanup_refusal_runtime/omarchy-kids/shortcut-policy.active ]] \
  && jq -e '.active == true and .status == "restore-failed"' \
    "$window_cleanup_refusal_dir/omarchy-kids/windows.json" >/dev/null \
  && rg -Fq 'shortcut restrictions were released' "$cleanup_refusal_error" \
  || fail "detached lifecycle cleanup does not release shortcuts while preserving failed window recovery"

window_dirty_inactive_dir=$(mktemp -d)
dirty_runtime=$window_dirty_inactive_dir/runtime
mkdir -p "$dirty_runtime/omarchy-kids"
printf 'version=1\n' > "$dirty_runtime/omarchy-kids/shortcut-policy.active"
window_result=$(
  HYPRLAND_INSTANCE_SIGNATURE=test-instance \
    XDG_STATE_HOME="$window_dirty_inactive_dir/state" \
    XDG_RUNTIME_DIR="$dirty_runtime" \
    OMARCHY_KIDS_CLEANUP_SETTLE_SECONDS=0 \
    OMARCHY_KIDS_HYPRCTL="$window_mock" \
    OMARCHY_KIDS_TEST_CLIENTS="$window_clients_kids" \
    OMARCHY_KIDS_TEST_WORKSPACES="$window_workspaces_kids" \
    OMARCHY_KIDS_TEST_WINDOW_LOG="$window_dirty_inactive_dir/hyprctl.log" \
    "$LIFECYCLE_CLEANUP" "$WINDOW_SESSION" "$SHORTCUT_POLICY"
)
jq -e '.action == "exit" and .applied == false and .restored == true' \
  <<< "$window_result" >/dev/null \
  && [[ ! -e $dirty_runtime/omarchy-kids/shortcut-policy.active ]] \
  && ! rg -q 'hl\.dsp\.window\.(close|move)' "$window_dirty_inactive_dir/hyprctl.log" \
  || fail "cleanup claims an unrelated workspace when there is no active session"

rm -rf -- "$window_dirty_inactive_dir" "$window_cleanup_refusal_dir" "$window_cleanup_dir" \
  "$window_stale_dir" "$window_hotplug_dir" "$window_legacy_dir" "$window_refusal_dir" \
  "$window_reused_dir" "$window_misdirected_dir" \
  "$window_residual_dir" "$window_multi_dir" "$window_missing_dir" "$window_test_dir"

shortcut_test_dir=$(mktemp -d)
shortcut_log=$shortcut_test_dir/hyprctl.log
shortcut_state_dir=$shortcut_test_dir/state
shortcut_fixture=$PLUGIN_ROOT/test/fixtures/stock-bindings.json
shortcut_mock=$PLUGIN_ROOT/test/hyprctl-mock
keybindings_fixture=$PLUGIN_ROOT/test/fixtures/stock-bindings.txt
keybindings_mock=$PLUGIN_ROOT/test/keybindings-mock
universal_fixture=$PLUGIN_ROOT/test/fixtures/universal-binding.json
kids_submap_fixture=$PLUGIN_ROOT/test/fixtures/kids-submap-binding.json

shortcut_result=$(
  XDG_STATE_HOME="$shortcut_state_dir" \
    XDG_RUNTIME_DIR="$shortcut_test_dir/runtime" \
    OMARCHY_KIDS_HYPRCTL="$shortcut_mock" \
    OMARCHY_KIDS_KEYBINDINGS="$keybindings_mock" \
    OMARCHY_KIDS_TEST_BINDS="$shortcut_fixture" \
    OMARCHY_KIDS_TEST_RENDERED_BINDS="$keybindings_fixture" \
    OMARCHY_KIDS_TEST_LOG="$shortcut_log" \
    "$SHORTCUT_POLICY" enter true true true
)
jq -e '.action == "enter" and .applied == true and .changed > 0' \
  <<< "$shortcut_result" >/dev/null \
  || fail "shortcut policy does not report a successful transient layer"
rg -Fq 'hl.define_submap("omarchy-kids", function()' "$shortcut_log" \
  && rg -Fq 'Kids Mode: Menu' "$shortcut_log" \
  && rg -Fq 'Kids Mode: Browser' "$shortcut_log" \
  && rg -Fq 'Kids Mode: Omawrite' "$shortcut_log" \
  && rg -Fq 'Kids Mode: Calculator' "$shortcut_log" \
  && rg -Fq 'hl.bind("SUPER + code:10", hl.dsp.focus({ workspace = "1" })' "$shortcut_log" \
  && rg -Fq 'Kids Mode: Workspace 1' "$shortcut_log" \
  && rg -Fq 'hl.bind("SUPER + code:19", hl.dsp.focus({ workspace = "10" })' "$shortcut_log" \
  && rg -Fq 'Kids Mode: Workspace 10' "$shortcut_log" \
  && rg -Fq 'hl.bind("SUPER + W", hl.dsp.window.close()' "$shortcut_log" \
  && rg -Fq 'hl.bind("XF86AudioRaiseVolume"' "$shortcut_log" \
  && rg -Fq 'hl.bind("SUPER + CTRL + L"' "$shortcut_log" \
  && rg -Fq 'hl.bind("switch:on:Lid Switch"' "$shortcut_log" \
  && rg -Fq 'hl.dispatch(hl.dsp.submap("omarchy-kids"))' "$shortcut_log" \
  && rg -Fq 'hl.get_current_submap() == "omarchy-kids"' "$shortcut_log" \
  && ! rg -Fq 'hl.unbind(' "$shortcut_log" \
  || fail "shortcut policy does not install and verify a default-deny submap"

: > "$shortcut_log"
shortcut_result=$(
  XDG_STATE_HOME="$shortcut_state_dir" \
    XDG_RUNTIME_DIR="$shortcut_test_dir/runtime" \
    OMARCHY_KIDS_HYPRCTL="$shortcut_mock" \
    OMARCHY_KIDS_KEYBINDINGS="$keybindings_mock" \
    OMARCHY_KIDS_TEST_BINDS="$shortcut_fixture" \
    OMARCHY_KIDS_TEST_RENDERED_BINDS="$keybindings_fixture" \
    OMARCHY_KIDS_TEST_LOG="$shortcut_log" \
    "$SHORTCUT_POLICY" enter false false false
)
jq -e '.action == "enter" and .applied == true' <<< "$shortcut_result" >/dev/null \
  || fail "shortcut policy cannot rebuild itself after a shell reload"
[[ $(rg -c '^reload$' "$shortcut_log") == 1 ]] \
  || fail "shortcut policy does not restore configuration before rebuilding its layer"
! rg -Fq 'Kids Mode: Browser' "$shortcut_log" \
  && ! rg -Fq 'Kids Mode: Omawrite' "$shortcut_log" \
  && ! rg -Fq 'Kids Mode: Calculator' "$shortcut_log" \
  || fail "shortcut policy does not follow the current default-app selection"

: > "$shortcut_log"
shortcut_result=$(
  XDG_STATE_HOME="$shortcut_state_dir" \
    XDG_RUNTIME_DIR="$shortcut_test_dir/runtime" \
    OMARCHY_KIDS_HYPRCTL="$shortcut_mock" \
    OMARCHY_KIDS_TEST_BINDS="$shortcut_fixture" \
    OMARCHY_KIDS_TEST_LOG="$shortcut_log" \
    "$SHORTCUT_POLICY" exit
)
jq -e '.action == "exit" and .applied == false and .restored == true' \
  <<< "$shortcut_result" >/dev/null \
  && [[ $(rg -c '^reload$' "$shortcut_log") == 1 ]] \
  && [[ ! -e $shortcut_test_dir/runtime/omarchy-kids/shortcut-policy.active ]] \
  || fail "shortcut policy does not restore Hyprland state on exit"
reset_before_line=$(rg -nF 'hl.dispatch(hl.dsp.submap("reset"))' "$shortcut_log" \
  | head -1 | cut -d: -f1)
reload_line=$(rg -n '^reload$' "$shortcut_log" | head -1 | cut -d: -f1)
reset_after_line=$(rg -nF 'hl.dispatch(hl.dsp.submap("reset"))' "$shortcut_log" \
  | tail -1 | cut -d: -f1)
[[ $reset_before_line -lt $reload_line && $reload_line -lt $reset_after_line ]] \
  || fail "shortcut policy does not leave the transient submap before reloading"

: > "$shortcut_log"
shortcut_result=$(
  XDG_STATE_HOME="$shortcut_state_dir" \
    XDG_RUNTIME_DIR="$shortcut_test_dir/transient-runtime" \
    OMARCHY_KIDS_HYPRCTL="$shortcut_mock" \
    OMARCHY_KIDS_TEST_BINDS="$shortcut_fixture" \
    OMARCHY_KIDS_TEST_LOG="$shortcut_log" \
    "$SHORTCUT_POLICY" enter true true true
)
jq -e '.action == "enter" and .applied == true' <<< "$shortcut_result" >/dev/null \
  || fail "shortcut policy cannot prepare the transient restore test"
: > "$shortcut_log"
shortcut_result=$(
  XDG_STATE_HOME="$shortcut_state_dir" \
    XDG_RUNTIME_DIR="$shortcut_test_dir/transient-runtime" \
    OMARCHY_KIDS_SHORTCUT_RESTORE_ATTEMPTS=3 \
    OMARCHY_KIDS_SHORTCUT_RESTORE_RETRY_SECONDS=0 \
    OMARCHY_KIDS_HYPRCTL="$shortcut_mock" \
    OMARCHY_KIDS_TEST_BINDS="$shortcut_fixture" \
    OMARCHY_KIDS_TEST_LOG="$shortcut_log" \
    OMARCHY_KIDS_TEST_FAIL_RESET_COUNT=2 \
    "$SHORTCUT_POLICY" exit
)
jq -e '.action == "exit" and .applied == false and .restored == true' \
  <<< "$shortcut_result" >/dev/null \
  && [[ $(rg -c '^reload$' "$shortcut_log") == 2 ]] \
  && [[ ! -e $shortcut_test_dir/transient-runtime/omarchy-kids/shortcut-policy.active ]] \
  || fail "shortcut policy does not recover from a transient restore failure"

: > "$shortcut_log"
shortcut_result=$(
  XDG_STATE_HOME="$shortcut_state_dir" \
    XDG_RUNTIME_DIR="$shortcut_test_dir/diagnostic-runtime" \
    OMARCHY_KIDS_HYPRCTL="$shortcut_mock" \
    OMARCHY_KIDS_TEST_BINDS="$shortcut_fixture" \
    OMARCHY_KIDS_TEST_LOG="$shortcut_log" \
    "$SHORTCUT_POLICY" enter true true true
)
jq -e '.action == "enter" and .applied == true' <<< "$shortcut_result" >/dev/null \
  || fail "shortcut policy cannot prepare the restore diagnostic test"
: > "$shortcut_log"
if shortcut_result=$(
  XDG_STATE_HOME="$shortcut_state_dir" \
    XDG_RUNTIME_DIR="$shortcut_test_dir/diagnostic-runtime" \
    OMARCHY_KIDS_SHORTCUT_RESTORE_ATTEMPTS=3 \
    OMARCHY_KIDS_SHORTCUT_RESTORE_RETRY_SECONDS=0 \
    OMARCHY_KIDS_HYPRCTL="$shortcut_mock" \
    OMARCHY_KIDS_TEST_BINDS="$shortcut_fixture" \
    OMARCHY_KIDS_TEST_LOG="$shortcut_log" \
    OMARCHY_KIDS_TEST_FAIL_RESET=true \
    "$SHORTCUT_POLICY" exit
); then
  fail "shortcut policy accepts an exhausted restore retry"
fi
jq -e '.action == "exit" and .applied == true and .restored == false
  and (.error | contains("failed after 3 attempts"))' <<< "$shortcut_result" >/dev/null \
  && jq -e '.version == 1 and .action == "exit" and .attempts == 3
    and .resolved == false and (.error | contains("mock submap reset failure"))' \
    "$shortcut_state_dir/omarchy-kids/shortcut-restore.json" >/dev/null \
  && [[ -f $shortcut_test_dir/diagnostic-runtime/omarchy-kids/shortcut-policy.active ]] \
  || fail "shortcut policy does not retain exact exhausted-restore diagnostics"
shortcut_result=$(
  XDG_STATE_HOME="$shortcut_state_dir" \
    XDG_RUNTIME_DIR="$shortcut_test_dir/diagnostic-runtime" \
    OMARCHY_KIDS_HYPRCTL="$shortcut_mock" \
    OMARCHY_KIDS_TEST_BINDS="$shortcut_fixture" \
    OMARCHY_KIDS_TEST_LOG="$shortcut_log" \
    "$SHORTCUT_POLICY" exit
)
jq -e '.action == "exit" and .applied == false and .restored == true' \
  <<< "$shortcut_result" >/dev/null \
  && jq -e '.resolved == true and .resolvedBy == "exit"
    and (.resolvedAt | type == "string")' \
    "$shortcut_state_dir/omarchy-kids/shortcut-restore.json" >/dev/null \
  || fail "shortcut policy does not mark a retained restore failure as recovered"

: > "$shortcut_log"
if shortcut_result=$(
  XDG_STATE_HOME="$shortcut_state_dir" \
    XDG_RUNTIME_DIR="$shortcut_test_dir/recovered-runtime" \
    OMARCHY_KIDS_HYPRCTL="$shortcut_mock" \
    OMARCHY_KIDS_KEYBINDINGS="$keybindings_mock" \
    OMARCHY_KIDS_TEST_BINDS="$shortcut_fixture" \
    OMARCHY_KIDS_TEST_RENDERED_BINDS="$keybindings_fixture" \
    OMARCHY_KIDS_TEST_LOG="$shortcut_log" \
    OMARCHY_KIDS_TEST_FAIL_EVAL=true \
    "$SHORTCUT_POLICY" enter true true true
); then
  fail "shortcut policy accepts a failed submap activation"
fi
jq -e '.action == "enter" and .applied == false
  and (.error | contains("Could not apply Kids Mode shortcuts"))' \
  <<< "$shortcut_result" >/dev/null \
  && [[ $(rg -c '^reload$' "$shortcut_log") == 1 ]] \
  && [[ ! -e $shortcut_test_dir/recovered-runtime/omarchy-kids/shortcut-policy.active ]] \
  || fail "shortcut policy does not clear ownership after verified recovery"

: > "$shortcut_log"
if shortcut_result=$(
  XDG_STATE_HOME="$shortcut_state_dir" \
    XDG_RUNTIME_DIR="$shortcut_test_dir/uncertain-runtime" \
    OMARCHY_KIDS_HYPRCTL="$shortcut_mock" \
    OMARCHY_KIDS_KEYBINDINGS="$keybindings_mock" \
    OMARCHY_KIDS_TEST_BINDS="$shortcut_fixture" \
    OMARCHY_KIDS_TEST_RENDERED_BINDS="$keybindings_fixture" \
    OMARCHY_KIDS_TEST_LOG="$shortcut_log" \
    OMARCHY_KIDS_TEST_FAIL_EVAL=true \
    OMARCHY_KIDS_TEST_FAIL_RELOAD=true \
    "$SHORTCUT_POLICY" enter true true true
); then
  fail "shortcut policy accepts failed activation and recovery"
fi
jq -e '.action == "enter" and .applied == false
  and (.error | contains("automatic restore also failed"))' \
  <<< "$shortcut_result" >/dev/null \
  && [[ -f $shortcut_test_dir/uncertain-runtime/omarchy-kids/shortcut-policy.active ]] \
  || fail "shortcut policy drops ownership after unverified recovery"
shortcut_result=$(
  XDG_STATE_HOME="$shortcut_state_dir" \
    XDG_RUNTIME_DIR="$shortcut_test_dir/uncertain-runtime" \
    OMARCHY_KIDS_HYPRCTL="$shortcut_mock" \
    OMARCHY_KIDS_TEST_BINDS="$shortcut_fixture" \
    OMARCHY_KIDS_TEST_LOG="$shortcut_log" \
    "$SHORTCUT_POLICY" exit
)
jq -e '.action == "exit" and .applied == false and .restored == true' \
  <<< "$shortcut_result" >/dev/null \
  && [[ ! -e $shortcut_test_dir/uncertain-runtime/omarchy-kids/shortcut-policy.active ]] \
  || fail "shortcut policy cannot recover retained ownership on retry"

if shortcut_result=$(
  XDG_STATE_HOME="$shortcut_state_dir" \
    XDG_RUNTIME_DIR="$shortcut_test_dir/universal-runtime" \
    OMARCHY_KIDS_HYPRCTL="$shortcut_mock" \
    OMARCHY_KIDS_TEST_BINDS="$universal_fixture" \
    OMARCHY_KIDS_TEST_LOG="$shortcut_log" \
    "$SHORTCUT_POLICY" enter true true true
); then
  fail "shortcut policy accepts a universal binding that bypasses submaps"
fi
jq -e '.action == "enter" and .applied == false
  and (.error | contains("universal Hyprland binding"))' \
  <<< "$shortcut_result" >/dev/null \
  || fail "shortcut policy does not explain a universal-binding refusal"

if shortcut_result=$(
  XDG_STATE_HOME="$shortcut_state_dir" \
    XDG_RUNTIME_DIR="$shortcut_test_dir/collision-runtime" \
    OMARCHY_KIDS_HYPRCTL="$shortcut_mock" \
    OMARCHY_KIDS_TEST_BINDS="$kids_submap_fixture" \
    OMARCHY_KIDS_TEST_LOG="$shortcut_log" \
    "$SHORTCUT_POLICY" enter true true true
); then
  fail "shortcut policy accepts a pre-existing binding in its target submap"
fi
jq -e '.action == "enter" and .applied == false
  and (.error | contains("submap name is already in use"))' \
  <<< "$shortcut_result" >/dev/null \
  || fail "shortcut policy does not explain a target-submap collision"
rm -rf -- "$shortcut_test_dir"

if rg -q 'PamContext|Services\.Pam|pkexec|sudo|enteredPassword|pendingPassword' \
  "$PLUGIN_ROOT/Panel.qml" "$PLUGIN_ROOT/Service.qml" "$PLUGIN_ROOT/ManagerWidget.qml"; then
  fail "the plugin handles credentials directly or invokes a privileged helper"
fi

rg -Fq 'import "BarActions.js" as BarActions' "$PLUGIN_ROOT/BarWidget.qml" \
  && rg -Fq 'root.kidsModeEnabled,' "$PLUGIN_ROOT/BarWidget.qml" \
  && rg -Fq 'buttonCode === Qt.RightButton' "$PLUGIN_ROOT/BarWidget.qml" \
  && rg -Fq 'if (command.length > 0)' "$PLUGIN_ROOT/BarWidget.qml" \
  || fail "the Omarchy bar button does not use mode-aware stock click routing"

if rg -q 'xdg-terminal-exec' \
    "$PLUGIN_ROOT/Menu.qml" "$PLUGIN_ROOT/ManagerWidget.qml" \
    "$PLUGIN_ROOT/Service.qml" "$PLUGIN_ROOT/kids-menu.jsonc"; then
  fail "a non-stock Kids control exposes a terminal action"
fi

if rg -q 'https?://|omarchy-launch-webapp|spotify|youtube|khan' "$MENU"; then
  fail "menu contains a hard-coded web app"
fi

validator=${OMARCHY_PLUGIN_VALIDATOR:-$(command -v omarchy-plugin-validate || true)}
[[ -n $validator ]] || fail "omarchy-plugin-validate is unavailable"
"$validator" "$PLUGIN_ROOT"

for file in "$PLUGIN_ROOT"/*.qml; do
  qmllint -I /usr/share/omarchy/shell "$file"
done

echo "Omarchy Kids Mode plugin checks passed"
