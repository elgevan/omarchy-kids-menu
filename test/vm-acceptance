#!/bin/bash

# Run inside a disposable, installed Omarchy graphical session. The caller
# must copy this Git repository into the guest before invoking the script.

set -Eeuo pipefail

PLUGIN_ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
PLUGIN_ID=io.github.elgevan.omarchy-kids
ARTIFACTS=${OMARCHY_KIDS_ACCEPTANCE_DIR:-/tmp/omarchy-kids-menu-acceptance}
ALLOWLIST="$HOME/.config/omarchy-kids/allowed-apps.json"
MODE_STATE="$HOME/.config/omarchy-kids/mode.json"
NOTIFICATION_STATE="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-kids/notifications.json"
KIDS_BROWSER_PROFILE="$HOME/.local/share/omarchy-kids/chromium"
MANAGER_ID=$PLUGIN_ID.manager
SHORTCUT_MARKER="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/omarchy-kids/shortcut-policy.active"

mkdir -p "$ARTIFACTS"
packages_before=$(pacman -Qq | sort)

pass() {
  printf 'ok - %s\n' "$1"
}

screenshot() {
  timeout 10 grim "$ARTIFACTS/$1.png" 2>/dev/null || true
}

fail() {
  local description=$1
  local detail=${2:-}
  [[ -n $detail ]] && printf '%s\n' "$detail" >&2
  screenshot "failure-${description// /-}"
  printf 'not ok - %s\n' "$description" >&2
  exit 1
}

wait_until() {
  local description=$1 timeout_seconds=$2
  shift 2
  local deadline=$((SECONDS + timeout_seconds))

  until "$@" >/dev/null 2>&1; do
    (( SECONDS < deadline )) || fail "$description" "timed out after ${timeout_seconds}s"
    sleep 1
  done
  pass "$description"
}

layer_present() {
  hyprctl -j layers | jq -e '[.. | objects | select(.namespace? == "omarchy-menu")] | length > 0'
}

layer_absent() {
  ! layer_present
}

screen_contains() {
  local text=$1 snapshot=/tmp/omarchy-kids-menu-ocr.png
  timeout 10 grim -s 2 "$snapshot" 2>/dev/null || return 1
  tesseract "$snapshot" stdout --psm 11 2>/dev/null | grep -Fi -- "$text" >/dev/null
}

screen_lacks() {
  ! screen_contains "$1"
}

desktop_present() {
  local id=$1 dir
  IFS=: read -ra dirs <<<"${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
  dirs=("$HOME/.local/share" "${dirs[@]}")
  for dir in "${dirs[@]}"; do
    [[ -f "$dir/applications/$id.desktop" ]] && return 0
  done
  return 1
}

plugin_enabled() {
  omarchy plugin list --json | jq -e --arg id "$PLUGIN_ID" '
    any(.[]; .id == $id and .enabled == true and .clonedFrom == "")
  '
}

stock_menu_restored() {
  omarchy plugin list --json | jq -e '
    any(.[]; .id == "omarchy.menu" and .enabled == true)
  '
}

stock_menu_blocked() {
  jq -e '(.disabledPlugins // []) | index("omarchy.menu") != null' \
    "$HOME/.config/omarchy/shell.json"
}

stock_menu_available() {
  jq -e '(.disabledPlugins // []) | index("omarchy.menu") == null' \
    "$HOME/.config/omarchy/shell.json"
}

kids_menu_summon() {
  local route=${1:-root}
  omarchy-shell shell summon "$PLUGIN_ID" "$(jq -nc --arg menu "$route" '{menu: $menu}')"
}

menu_symbol_on_left() {
  jq -e --arg id "$PLUGIN_ID" '
    any(.bar.layout.left[]?; ((if type == "object" then .id else . end) == $id))
  ' "$HOME/.config/omarchy/shell.json"
}

manager_on_right() {
  jq -e --arg id "$MANAGER_ID" '
    any(.bar.layout.right[]?;
      type == "object" and .id == $id and .type == "qml" and (.source | endswith("/ManagerWidget.qml")))
  ' "$HOME/.config/omarchy/shell.json"
}

manager_absent() {
  jq -e --arg id "$MANAGER_ID" '
    [.bar.layout.left[]?, .bar.layout.center[]?, .bar.layout.right[]?]
    | all((if type == "object" then .id else . end) != $id)
  ' "$HOME/.config/omarchy/shell.json"
}

dnd_is() {
  [[ $(omarchy-shell notifications isDnd 2>/dev/null) == "$1" ]]
}

mode_is() {
  local current=on
  if [[ -f $MODE_STATE ]] && ! jq -e '.version == 1 and .enabled == true' "$MODE_STATE" >/dev/null 2>&1; then
    current=off
  fi
  [[ $current == "$1" ]]
}

lock_is() {
  [[ $(omarchy-shell lock isLocked 2>/dev/null) == "$1" ]]
}

binding_description_present() {
  local description=$1
  hyprctl binds -j | jq -e --arg description "$description" \
    'any(.[]; .description == $description)'
}

binding_description_absent() {
  ! binding_description_present "$1"
}

youtube_window_with_kids_profile() {
  local pid command
  while read -r pid; do
    [[ $pid =~ ^[1-9][0-9]*$ && -r /proc/$pid/cmdline ]] || continue
    command=$(tr '\0' ' ' < "/proc/$pid/cmdline")
    [[ $command == *"--user-data-dir=$KIDS_BROWSER_PROFILE"* ]] && return 0
  done < <(hyprctl -j clients | jq -r '
    .[]
    | select(.workspace.name == "omarchy-kids")
    | select((.class|ascii_downcase|contains("youtube")) or (.title|ascii_downcase|contains("youtube")))
    | .pid
  ')
  return 1
}

close_kids_youtube_window() {
  local address
  address=$(hyprctl -j clients | jq -r '
    .[]
    | select(.workspace.name == "omarchy-kids")
    | select((.class|ascii_downcase|contains("youtube")) or (.title|ascii_downcase|contains("youtube")))
    | .address
  ' | head -1)
  [[ -n $address ]] || return 0
  hyprctl --quiet dispatch "hl.dsp.window.close({ window = \"address:$address\" })"
}

cleanup() {
  omarchy-shell shell hide omarchy.menu >/dev/null 2>&1 || true
  omarchy-shell shell hide "$PLUGIN_ID" >/dev/null 2>&1 || true
  if omarchy plugin list --json 2>/dev/null | jq -e --arg id "$PLUGIN_ID" 'any(.[]; .id == $id)' >/dev/null; then
    omarchy plugin disable "$PLUGIN_ID" >/dev/null 2>&1 || true
    omarchy plugin remove "$PLUGIN_ID" --yes >/dev/null 2>&1 || true
  fi
  if lock_is true && [[ -n ${OMARCHY_KIDS_TEST_PASSWORD:-} ]]; then
    wtype "$OMARCHY_KIDS_TEST_PASSWORD" -s 750 -k Return >/dev/null 2>&1 || true
    sleep 2
  fi
  rm -f -- "$ALLOWLIST" "$MODE_STATE" "$NOTIFICATION_STATE"
}
trap cleanup EXIT

cleanup
dnd_before=$(omarchy-shell notifications isDnd)
[[ $dnd_before == on || $dnd_before == off ]] || fail "read initial notification state"

omarchy plugin add "file://$PLUGIN_ROOT" --enable --yes
wait_until "standalone kids plugin becomes active" 20 plugin_enabled
wait_until "normal Omarchy menu symbol remains on the left" 20 menu_symbol_on_left
wait_until "separate Kids manager appears on the right" 20 manager_on_right
wait_until "Kids Mode defaults to on" 20 mode_is on
wait_until "kids mode enables Do Not Disturb" 20 dnd_is on
wait_until "Kids Mode blocks the unrestricted stock menu" 20 stock_menu_blocked
wait_until "Kids Mode redirects the normal menu shortcut" 20 \
  binding_description_present "Kids Mode: Menu"
wait_until "Kids Mode redirects the Apps shortcut" 20 \
  binding_description_present "Kids Mode: Apps"
wait_until "Kids Mode redirects browser shortcuts" 20 \
  binding_description_present "Kids Mode: Browser"
wait_until "Kids Mode blocks the stock terminal shortcut" 20 \
  binding_description_absent "Terminal"
wait_until "Kids Mode blocks the DND bypass shortcut" 20 \
  binding_description_absent "Toggle silencing notifications"
binding_description_present "Kids Mode: Omawrite" \
  || fail "selected Omawrite shortcut is not guarded"
pass "selected Omawrite shortcut is guarded"
binding_description_present "Kids Mode: Calculator" \
  || fail "selected Omacalc shortcut is not guarded"
pass "selected Omacalc shortcut is guarded"
[[ -f $SHORTCUT_MARKER ]] || fail "transient shortcut ownership marker is missing"
pass "transient shortcut ownership is recorded"
[[ $(omarchy-shell shell call "$PLUGIN_ID" ping '{}') == ok ]] \
  || fail "kids menu answers its standalone IPC"
pass "kids menu answers its standalone IPC"
[[ $(omarchy menu ping) == unknown ]] || fail "stock menu IPC is unavailable in Kids Mode"
pass "stock menu IPC is unavailable in Kids Mode"

notify-send -a "Kids Mode Acceptance" "Hidden in Kids Mode"
sleep 1
screen_lacks "Hidden in Kids Mode" || fail "ordinary notification is suppressed in kids mode"
pass "ordinary notification is suppressed in kids mode"

installed="$HOME/.config/omarchy/plugins/$PLUGIN_ID"
omarchy plugin validate "$installed"
pass "installed plugin passes Omarchy validation"

kids_menu_summon root >/dev/null
wait_until "kids root menu opens" 15 layer_present
if command -v omarchy-theme-switcher >/dev/null || command -v omarchy-theme-bg-switcher >/dev/null; then
  wait_until "flat root includes Style when Omarchy style tools exist" 15 screen_contains Style
else
  wait_until "Style is omitted without Omarchy style tools" 15 screen_lacks Style
fi

while IFS='|' read -r id label; do
  if desktop_present "$id"; then
    wait_until "installed default $label is visible" 15 screen_contains "$label"
  else
    wait_until "absent default $label is omitted" 15 screen_lacks "$label"
  fi
done <<'DEFAULTS'
google-chrome|Google Chrome
chromium|Chromium
omawrite|Omawrite
omacalc|Omacalc
DEFAULTS

wait_until "non-allowlisted Omacut is hidden" 15 screen_lacks Omacut
wait_until "old hard-coded Spotify entry is gone" 15 screen_lacks Spotify
wait_until "old hard-coded YouTube Kids entry is gone" 15 screen_lacks "YouTube Kids"
screenshot success-default-installed-app-filter
wtype -k Escape
wait_until "kids root closes" 15 layer_absent

mkdir -p "$(dirname -- "$ALLOWLIST")"
jq -n '{version: 1, allowedDesktopIds: ["YouTube", "chromium", "omacalc", "omawrite", "omacut"]}' > "$ALLOWLIST"
sleep 1

kids_menu_summon apps >/dev/null
wait_until "legacy Apps route opens the flat root" 15 layer_present
if desktop_present omacut; then
  wait_until "a user-added installed app appears" 15 screen_contains Omacut
fi
screenshot success-user-added-app
wtype -k Escape
wait_until "legacy Apps route closes" 15 layer_absent

if desktop_present YouTube && command -v chromium >/dev/null; then
  kids_menu_summon apps >/dev/null
  wait_until "kids root opens for web-app launch" 15 layer_present
  wtype YouTube -s 100 -k Return
  wait_until "YouTube uses the Kids Chromium profile" 20 youtube_window_with_kids_profile
  close_kids_youtube_window
  pass "Kids web-app window closed after profile check"
else
  pass "Kids web-app profile check skipped (YouTube or Chromium absent)"
fi

kids_menu_summon system >/dev/null
wait_until "blocked stock route returns to kids root" 15 layer_present
wait_until "blocked stock route does not expose Lock" 15 screen_lacks Lock
wait_until "blocked stock route still shows Style" 15 screen_contains Style
wtype -k Escape
wait_until "blocked stock route closes" 15 layer_absent

if rg -q 'sourceAppLibrary\.remove|omarchy-(install|pkg|remove)|xdg-terminal-exec' \
  "$installed/Menu.qml" "$installed/Service.qml" "$installed/BarWidget.qml" "$installed/ManagerWidget.qml" "$installed/kids-menu.jsonc"; then
  fail "installed plugin contains an app/package mutation or terminal shortcut"
fi
pass "installed app handling remains filter-only"

if [[ -n ${OMARCHY_KIDS_TEST_PASSWORD:-} ]]; then
  omarchy-shell "$MANAGER_ID" show
  wait_until "Kids Mode manager opens" 15 screen_contains "KIDS MODE"
  wtype -M ctrl -M shift -k k -m shift -m ctrl
  wait_until "turning Kids Mode off opens authentication" 15 lock_is true
  wait_until "mode stays on before authentication" 15 mode_is on

  fingerprint=$(omarchy-shell lock status | jq -r '.fingerprint')
  if [[ $fingerprint != true ]]; then
    wtype __omarchy_kids_invalid_password__ -s 750 -k Return
    sleep 2
    lock_is true || fail "wrong password keeps the session locked"
    mode_is on || fail "wrong password keeps Kids Mode on"
    pass "wrong password keeps Kids Mode on"
  fi

  wtype "$OMARCHY_KIDS_TEST_PASSWORD" -s 750 -k Return
  wait_until "valid authentication unlocks the session" 20 lock_is false
  wait_until "valid authentication turns Kids Mode off" 20 mode_is off
  wait_until "internal Off restores the prior DND state" 20 dnd_is "$dnd_before"
  wait_until "internal Off restores stock menu IPC" 20 stock_menu_available
  wait_until "internal Off restores the stock menu shortcut" 20 \
    binding_description_present "Omarchy menu"
  wait_until "internal Off restores the terminal shortcut" 20 \
    binding_description_present "Terminal"
  wait_until "internal Off removes the transient shortcut layer" 20 \
    binding_description_absent "Kids Mode: Menu"
  manager_on_right || fail "Kids Mode manager remains available while off"
  pass "Kids Mode manager remains available while off"

  omarchy menu summon root >/dev/null
  wait_until "internal Off opens the normal menu" 15 layer_present
  wait_until "normal menu shows Learn" 15 screen_contains Learn
  wait_until "normal menu shows Setup" 15 screen_contains Setup
  screenshot success-internal-mode-off
  wtype -k Escape
  wait_until "normal menu closes after internal Off test" 15 layer_absent

  kids_menu_summon root >/dev/null
  wait_until "standalone menu also shows normal content while off" 15 layer_present
  wait_until "standalone normal menu shows Learn" 15 screen_contains Learn
  wtype -k Escape
  wait_until "standalone normal menu closes while off" 15 layer_absent

  omarchy-shell "$MANAGER_ID" show
  wait_until "Kids Mode manager reopens while off" 15 screen_contains "KIDS MODE"
  wtype -M ctrl -M shift -k k -m shift -m ctrl
  wait_until "turning Kids Mode on is immediate" 15 mode_is on
  wait_until "turning Kids Mode on remutes notifications" 15 dnd_is on
  wait_until "turning Kids Mode on blocks stock menu IPC again" 15 stock_menu_blocked
  wait_until "turning Kids Mode on reapplies shortcut filtering" 15 \
    binding_description_present "Kids Mode: Menu"
  lock_is false || fail "turning Kids Mode on unexpectedly requested authentication"
  pass "turning Kids Mode on does not request authentication"
  omarchy-shell "$MANAGER_ID" hide
else
  pass "authenticated in-app toggle test skipped (set OMARCHY_KIDS_TEST_PASSWORD in a disposable VM)"
fi

packages_after=$(pacman -Qq | sort)
[[ $packages_before == "$packages_after" ]] || fail "plugin changed the installed package set"
pass "installed package set is unchanged"

omarchy plugin disable "$PLUGIN_ID"
wait_until "disabling kids mode restores the stock menu" 20 stock_menu_restored
wait_until "disabling kids mode removes the right manager widget" 20 manager_absent
wait_until "disabling kids mode restores the prior DND state" 20 dnd_is "$dnd_before"
wait_until "disabling kids mode restores stock shortcuts" 20 \
  binding_description_present "Omarchy menu"
wait_until "disabling kids mode restores direct app shortcuts" 20 \
  binding_description_present "Terminal"
wait_until "disabling kids mode removes Kids shortcut bindings" 20 \
  binding_description_absent "Kids Mode: Menu"
[[ ! -e $SHORTCUT_MARKER ]] || fail "shortcut marker remains after plugin disable"
[[ -z $(hyprctl configerrors) ]] || fail "Hyprland reports configuration errors after shortcut restore"
pass "Hyprland shortcut restore is clean"

omarchy menu summon root >/dev/null
wait_until "restored stock menu opens" 15 layer_present
wait_until "restored stock menu shows Learn" 15 screen_contains Learn
wait_until "restored stock menu shows Setup" 15 screen_contains Setup
screenshot success-stock-menu-restored
wtype -k Escape
wait_until "restored stock menu closes" 15 layer_absent

trap - EXIT
cleanup
pass "Omarchy Kids menu VM acceptance passed"
