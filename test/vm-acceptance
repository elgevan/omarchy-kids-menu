#!/bin/bash

# Run inside a disposable, installed Omarchy graphical session. The caller
# must copy this Git repository into the guest before invoking the script.

set -Eeuo pipefail

PLUGIN_ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
PLUGIN_ID=omarchy-kids.menu
ARTIFACTS=${OMARCHY_KIDS_ACCEPTANCE_DIR:-/tmp/omarchy-kids-menu-acceptance}
ALLOWLIST="$HOME/.config/omarchy-kids/allowed-apps.json"

mkdir -p "$ARTIFACTS"
packages_before=$(pacman -Qq | sort)

pass() {
  printf 'ok - %s\n' "$1"
}

screenshot() {
  timeout 10 grim "$ARTIFACTS/$1.png" 2>/dev/null || true
}

fail() {
  local description=$1
  local detail=${2:-}
  [[ -n $detail ]] && printf '%s\n' "$detail" >&2
  screenshot "failure-${description// /-}"
  printf 'not ok - %s\n' "$description" >&2
  exit 1
}

wait_until() {
  local description=$1 timeout_seconds=$2
  shift 2
  local deadline=$((SECONDS + timeout_seconds))

  until "$@" >/dev/null 2>&1; do
    (( SECONDS < deadline )) || fail "$description" "timed out after ${timeout_seconds}s"
    sleep 1
  done
  pass "$description"
}

layer_present() {
  hyprctl -j layers | jq -e '[.. | objects | select(.namespace? == "omarchy-menu")] | length > 0'
}

layer_absent() {
  ! layer_present
}

screen_contains() {
  local text=$1 snapshot=/tmp/omarchy-kids-menu-ocr.png
  timeout 10 grim -s 2 "$snapshot" 2>/dev/null || return 1
  tesseract "$snapshot" stdout --psm 11 2>/dev/null | grep -Fi -- "$text" >/dev/null
}

screen_lacks() {
  ! screen_contains "$1"
}

desktop_present() {
  local id=$1 dir
  IFS=: read -ra dirs <<<"${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
  dirs=("$HOME/.local/share" "${dirs[@]}")
  for dir in "${dirs[@]}"; do
    [[ -f "$dir/applications/$id.desktop" ]] && return 0
  done
  return 1
}

plugin_enabled() {
  omarchy plugin list --json | jq -e --arg id "$PLUGIN_ID" '
    any(.[]; .id == $id and .enabled == true and .clonedFrom == "omarchy.menu")
  '
}

stock_menu_restored() {
  omarchy plugin list --json | jq -e '
    any(.[]; .id == "omarchy.menu" and .enabled == true)
  '
}

cleanup() {
  omarchy-shell shell hide omarchy.menu >/dev/null 2>&1 || true
  if omarchy plugin list --json 2>/dev/null | jq -e --arg id "$PLUGIN_ID" 'any(.[]; .id == $id)' >/dev/null; then
    omarchy plugin disable "$PLUGIN_ID" >/dev/null 2>&1 || true
    omarchy plugin remove "$PLUGIN_ID" --yes >/dev/null 2>&1 || true
  fi
  rm -f -- "$ALLOWLIST"
}
trap cleanup EXIT

cleanup

omarchy plugin add "file://$PLUGIN_ROOT" --enable --yes
wait_until "kids plugin becomes the active Omarchy menu" 20 plugin_enabled
[[ $(omarchy menu ping) == ok ]] || fail "kids menu answers stock menu IPC"
pass "kids menu answers stock menu IPC"

installed="$HOME/.config/omarchy/plugins/$PLUGIN_ID"
omarchy plugin validate "$installed"
pass "installed plugin passes Omarchy validation"

omarchy menu summon root >/dev/null
wait_until "kids root menu opens" 15 layer_present
if command -v omarchy-theme-switcher >/dev/null || command -v omarchy-theme-bg-switcher >/dev/null; then
  wait_until "flat root includes Style when Omarchy style tools exist" 15 screen_contains Style
else
  wait_until "Style is omitted without Omarchy style tools" 15 screen_lacks Style
fi

while IFS='|' read -r id label; do
  if desktop_present "$id"; then
    wait_until "installed default $label is visible" 15 screen_contains "$label"
  else
    wait_until "absent default $label is omitted" 15 screen_lacks "$label"
  fi
done <<'DEFAULTS'
google-chrome|Google Chrome
chromium|Chromium
omawrite|Omawrite
omacalc|Omacalc
DEFAULTS

wait_until "non-allowlisted Omacut is hidden" 15 screen_lacks Omacut
wait_until "old hard-coded Spotify entry is gone" 15 screen_lacks Spotify
wait_until "old hard-coded YouTube Kids entry is gone" 15 screen_lacks "YouTube Kids"
screenshot success-default-installed-app-filter
wtype -k Escape
wait_until "kids root closes" 15 layer_absent

mkdir -p "$(dirname -- "$ALLOWLIST")"
jq -n '{version: 1, allowedDesktopIds: ["chromium", "omacalc", "omawrite", "omacut"]}' > "$ALLOWLIST"
sleep 1

omarchy menu summon apps >/dev/null
wait_until "legacy Apps route opens the flat root" 15 layer_present
if desktop_present omacut; then
  wait_until "a user-added installed app appears" 15 screen_contains Omacut
fi
screenshot success-user-added-app
wtype -k Escape
wait_until "legacy Apps route closes" 15 layer_absent

omarchy menu summon system >/dev/null
wait_until "blocked stock route returns to kids root" 15 layer_present
wait_until "blocked stock route does not expose Lock" 15 screen_lacks Lock
wait_until "blocked stock route still shows Style" 15 screen_contains Style
wtype -k Escape
wait_until "blocked stock route closes" 15 layer_absent

if rg -q 'sourceAppLibrary\.remove|omarchy-(install|pkg|remove)|xdg-terminal-exec' \
  "$installed/Menu.qml" "$installed/Service.qml" "$installed/BarWidget.qml" "$installed/kids-menu.jsonc"; then
  fail "installed plugin contains an app/package mutation or terminal shortcut"
fi
pass "installed plugin is filter-only"

packages_after=$(pacman -Qq | sort)
[[ $packages_before == "$packages_after" ]] || fail "plugin changed the installed package set"
pass "installed package set is unchanged"

omarchy plugin disable "$PLUGIN_ID"
wait_until "disabling kids mode restores the stock menu" 20 stock_menu_restored

omarchy menu summon root >/dev/null
wait_until "restored stock menu opens" 15 layer_present
wait_until "restored stock menu shows Learn" 15 screen_contains Learn
wait_until "restored stock menu shows Setup" 15 screen_contains Setup
screenshot success-stock-menu-restored
wtype -k Escape
wait_until "restored stock menu closes" 15 layer_absent

trap - EXIT
cleanup
pass "Omarchy Kids menu VM acceptance passed"
